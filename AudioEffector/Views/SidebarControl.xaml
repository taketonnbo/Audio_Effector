<UserControl x:Class="AudioEffector.Views.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AudioEffector.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="200">
    <UserControl.Resources>
        <Style x:Key="SidebarRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="GroupName" Value="SidebarNavigation"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="AccentLine" Width="4" HorizontalAlignment="Left" Background="#00FFFF" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#00FFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                <Setter Property="Foreground" Value="#00FFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarIconStyle" TargetType="Path">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="SidebarTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" 
            Width="50" 
            Background="{DynamicResource PanelBackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="0,0,1,0"
            HorizontalAlignment="Left"
            ClipToBounds="True">
        
        <!-- Animation Triggers -->
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootBorder" 
                                         Storyboard.TargetProperty="Width"
                                         To="200" 
                                         Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootBorder" 
                                         Storyboard.TargetProperty="Width"
                                         To="50" 
                                         Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid Margin="0,10,0,10" Width="200" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Navigation Items -->
            <StackPanel Grid.Row="0">
                <!-- All Songs (Music Note) -->
                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static vm:ViewType.AllSongs}">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M12 3V13.55C11.41 13.21 10.73 13 10 13C7.79 13 6 14.79 6 17C6 19.21 7.79 21 10 21C12.21 21 14 19.21 14 17V7H18V3H12Z" />
                        <TextBlock Style="{StaticResource SidebarTextStyle}" Text="すべての曲" />
                    </StackPanel>
                </RadioButton>
                
                <!-- Albums (Disc) -->
                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" IsChecked="True" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static vm:ViewType.Albums}">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8M12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14Z" />
                        <TextBlock Style="{StaticResource SidebarTextStyle}" Text="アルバム" />
                    </StackPanel>
                </RadioButton>

                <!-- Artists (Microphone) -->
                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static vm:ViewType.Artists}">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z" />
                        <TextBlock Style="{StaticResource SidebarTextStyle}" Text="アーティスト" />
                    </StackPanel>
                </RadioButton>

                <!-- Folders -->
                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static vm:ViewType.Folders}">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M10 4H4C2.9 4 2.01 4.9 2.01 6L2 18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6H12L10 4Z" />
                        <TextBlock Style="{StaticResource SidebarTextStyle}" Text="フォルダ" />
                    </StackPanel>
                </RadioButton>

                <!-- Favorites -->
                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static vm:ViewType.Favorites}">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" />
                        <TextBlock Style="{StaticResource SidebarTextStyle}" Text="お気に入り" />
                    </StackPanel>
                </RadioButton>

                <!-- Playlists -->
                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static vm:ViewType.Playlists}">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M15,6H3V8H15V6M15,10H3V12H15V10M3,16H11V14H3V16M17,6V14.18C16.69,14.07 16.35,14 16,14A3,3 0 0,0 13,17A3,3 0 0,0 16,20A3,3 0 0,0 19,17V8H22V6H17Z" />
                        <TextBlock Style="{StaticResource SidebarTextStyle}" Text="プレイリスト" />
                    </StackPanel>
                </RadioButton>

                <!-- Recent -->
                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static vm:ViewType.Recent}">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,11V5H12.5V10.4L17.3,15.2L16.2,16.2Z" />
                        <TextBlock Style="{StaticResource SidebarTextStyle}" Text="最近再生した曲" />
                    </StackPanel>
                </RadioButton>

                <!-- Equalizer -->
                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static vm:ViewType.Equalizer}">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M14,19H18V5H14M6,19H10V5H6M12,5V19H12V5Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" StrokeThickness="2" Fill="Transparent"/>
                        <TextBlock Style="{StaticResource SidebarTextStyle}" Text="イコライザー" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- Settings (Bottom) -->
            <StackPanel Grid.Row="2">
                <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Width="180">
                        <Path Style="{StaticResource SidebarIconStyle}" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                        <TextBlock Style="{StaticResource SidebarTextStyle}" Text="設定" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
