<Window x:Class="AudioEffector.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioEffector.Views"
        mc:Ignorable="d"
        Title="設定" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" Background="#121212" Foreground="White"
        FontFamily="Segoe UI">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="設定" FontSize="24" FontWeight="Bold" Foreground="#00FFFF" Margin="0,0,0,20"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Menu -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" 
                     Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Margin" Value="0,0,0,5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                            <Setter Property="Foreground" Value="#00FFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#222222"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Separator -->
            <Rectangle Grid.Column="1" Fill="#333333" Width="1" HorizontalAlignment="Center" Margin="0,10"/>

            <!-- Settings Content (Placeholder) -->
            <Grid Grid.Column="2">
                <TextBlock Text="{Binding SelectedCategory, StringFormat='{}「{0}」の設定項目がここに入ります。'}" 
                           FontSize="18" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Grid>
        </Grid>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="閉じる" Click="CloseButton_Click" Width="100" Height="30" Background="#333333" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
