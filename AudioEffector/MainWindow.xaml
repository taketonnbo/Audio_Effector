<Window x:Class="AudioEffector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioEffector"
        xmlns:vm="clr-namespace:AudioEffector.ViewModels"
        xmlns:services="clr-namespace:AudioEffector.Services"
        xmlns:views="clr-namespace:AudioEffector.Views"
        mc:Ignorable="d"
        Title="Audio Effector" Height="650" Width="1000"
        Icon="pack://application:,,,/Audio_Effector_icon_1.0.1.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        x:Name="MainWindowRoot">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        
        <Color x:Key="NeonCyanColor">#00FFFF</Color>
        <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyanColor}"/>

        
        <!-- ScrollBar Style (Simplified) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#404040"/>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="NeonSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="{TemplateBinding MinWidth}"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TickBar x:Name="TopTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Top" Height="4" Grid.ColumnSpan="3"/>
                            <TickBar x:Name="BottomTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Bottom" Height="4" Grid.ColumnSpan="3"/>
                            <Border x:Name="TrackBackground" Background="{DynamicResource ControlBackgroundHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Margin="5,0" VerticalAlignment="Center" Height="4.0" Grid.Column="1"/>
                            <Track x:Name="PART_Track" Grid.Column="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{StaticResource NeonCyanBrush}" Opacity="0.5" BorderThickness="0" Height="4" VerticalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" BorderThickness="0" Height="4" VerticalAlignment="Center"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Background="White" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Vertical Slider Style -->
        <Style x:Key="NeonVerticalSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Left" Width="4" Grid.RowSpan="3"/>
                            <TickBar x:Name="BottomTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Right" Width="4" Grid.RowSpan="3"/>
                            <Border x:Name="TrackBackground" Background="{DynamicResource ControlBackgroundHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,5" HorizontalAlignment="Center" Width="4.0" Grid.Row="1"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0" Width="4" HorizontalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="{StaticResource NeonCyanBrush}" Opacity="0.5" BorderThickness="0" Width="4" HorizontalAlignment="Center"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Background="White" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume Slider Style (Darker Blue) -->
        <Color x:Key="NeonVolumeColor">#008B8B</Color>
        <SolidColorBrush x:Key="NeonVolumeBrush" Color="{StaticResource NeonVolumeColor}"/>

        <Style x:Key="NeonVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Left" Width="4" Grid.RowSpan="3"/>
                            <TickBar x:Name="BottomTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Right" Width="4" Grid.RowSpan="3"/>
                            <Border x:Name="TrackBackground" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,5" HorizontalAlignment="Center" Width="4.0" Grid.Row="1"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0" Width="4" HorizontalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="{StaticResource NeonVolumeBrush}" Opacity="0.5" BorderThickness="0" Width="4" HorizontalAlignment="Center"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Background="White" BorderBrush="{StaticResource NeonVolumeBrush}" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel>
        <views:SidebarControl DockPanel.Dock="Left"/>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LeftColumnWidth, Mode=TwoWay}" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Library -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <views:FolderView Grid.Row="2" Visibility="{Binding IsFolderViewVisible, Converter={StaticResource BoolToVis}}" />
            <views:LibraryView Grid.Row="2" Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}" />
            <views:PlaylistSelectorView Grid.Row="2" Visibility="{Binding IsPlaylistSelectorVisible, Converter={StaticResource BoolToVis}}" />
            <views:PlaylistTracksView Grid.Row="2" Visibility="{Binding IsPlaylistTracksVisible, Converter={StaticResource BoolToVis}}" />
            
            <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="LOADING..." Foreground="{StaticResource NeonCyanBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <!-- Simple spinner animation could be added here, using text for now -->
                </StackPanel>
            </Grid>
        </Grid>


        <!-- GridSplitter (Vertical) -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ControlBackgroundBrush}"/>

        <!-- Right Column: Player & EQ -->
        <Grid Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/> <!-- Top Section (Now Playing + Controls) -->
                <RowDefinition Height="Auto"/> <!-- Splitter -->
                <RowDefinition Height="*"/> <!-- Bottom Section (EQ + Presets) -->
            </Grid.RowDefinitions>

            <!-- Top Section: Now Playing + Controls -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/> <!-- Album Art & Info -->
                    <RowDefinition Height="Auto"/> <!-- Controls -->
                </Grid.RowDefinitions>

                <!-- Album Art & Info -->
                <Grid Grid.Row="0" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Album Art -->
                        <ColumnDefinition Width="*"/>    <!-- Album Info -->
                    </Grid.ColumnDefinitions>

                    <!-- Large Cover Art -->
                    <Border Grid.Column="0" CornerRadius="4" Background="{DynamicResource ControlBackgroundBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Image Source="{Binding NowPlayingImage}" Stretch="Uniform"/>
                    </Border>

                    <!-- Album Info (Right Side) -->
                    <Grid Grid.Column="1" Margin="20,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Album Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding PlaybackListName, FallbackValue='No Album Selected'}" FontSize="24" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Segoe UI Light" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PlaybackListSubtitle, FallbackValue=''}" FontSize="16" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            
                            <!-- Quality Info (Moved here) -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentTrack.QualityLabel}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentTrack.QualityLabel}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CurrentTrack.QualityLabel}" FontSize="10" Foreground="#FFD700" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding CurrentTrack.QualityInfo}" FontSize="11" Foreground="{DynamicResource MutedTextForegroundBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Tracklist -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PlaybackListTracks}" AlternationCount="999">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left" Margin="0,2" Background="Transparent" BorderThickness="0">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Header" Value="再生" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                                            <Condition Binding="{Binding PlacementTarget.Tag.IsPlaying, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Header" Value="停止" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                    </MenuItem>
                                                    <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="お気に入りに追加/解除" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="プロパティ" Command="{Binding PlacementTarget.Tag.ShowTrackPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="ファイルの場所を開く" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Track Number (Index + 1) -->
                                                <TextBlock Grid.Column="0" Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter, AncestorLevel=2}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexConverter}, StringFormat='{}{0:00}.'}" 
                                                           Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                
                                                <!-- Playing Indicator -->
                                                <Path Grid.Column="2" Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{StaticResource NeonCyanBrush}" Width="10" Height="10" Stretch="Uniform" Margin="5,0,0,0">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True"> <!-- Assuming Track has IsPlaying or similar, or we need a converter comparing with CurrentTrack -->
                                                                     <!-- Since Track model might not have IsPlaying, we might skip this for now or use a converter. 
                                                                          Let's keep it simple for now and just show the list. -->
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Controls Area -->
                <Grid Grid.Row="1" Margin="20,0,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Left: Controls -->
                        <ColumnDefinition Width="*"/>    <!-- Center: Seek & Title -->
                        <ColumnDefinition Width="Auto"/> <!-- Right: Fav & Add -->
                    </Grid.ColumnDefinitions>

                    <!-- Left Group: Shuffle, Prev, Play, Repeat, Next -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Shuffle -->
                        <ToggleButton IsChecked="{Binding IsShuffleEnabled}" Margin="0,0,15,0" Background="Transparent" BorderThickness="0" ToolTip="Shuffle">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Path Data="M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4M14.83,13.41L13.42,14.83L16.55,17.96L14.5,20H20V14.5L17.96,16.54" 
                                              Width="16" Height="16" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="#606060"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Prev -->
                        <Button Command="{Binding PreviousCommand}" Margin="0,0,15,0" ToolTip="Previous">
                            <Path Data="M6,6h2v12H6V6z M9.5,12l8.5,6V6L9.5,12z" Fill="{StaticResource NeonCyanBrush}" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        
                        <!-- Play/Pause -->
                        <Button Command="{Binding TogglePlayPauseCommand}" Width="40" Height="40" Margin="0,0,15,0" ToolTip="Play/Pause">
                            <Grid>
                                <Ellipse Stroke="{StaticResource NeonCyanBrush}" StrokeThickness="2" Fill="Transparent"/>
                                <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="2,0,0,0"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                <Path Data="M6,19h4V5H6V19z M14,5v14h4V5H14z" Fill="White" Width="14" Height="14" Stretch="Uniform"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>

                        <!-- Next -->
                        <Button Command="{Binding NextCommand}" Margin="0,0,15,0" ToolTip="Next">
                            <Path Data="M6,18l8.5-6L6,6V18z M16,6v12h2V6H16z" Fill="{StaticResource NeonCyanBrush}" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>

                        <!-- Repeat -->
                        <ToggleButton Command="{Binding ToggleRepeatCommand}" IsChecked="{Binding IsAlbumRepeat, Mode=OneWay}" Width="16" Height="16" Background="Transparent" BorderThickness="0" ToolTip="Repeat">
                             <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Path Data="M7,7h10v3l4-4l-4-4v3H5v6h2V7z M17,17H7v-3l-4,4l4,4v-3h12v-6h-2V17z" Stretch="Uniform" Width="16" Height="16">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="#606060"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlbumRepeat}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        
                        <!-- Play Queue -->
                        <Button Command="{Binding ShowQueueDialogCommand}" Margin="15,0,0,0" ToolTip="Play Queue" Background="Transparent" BorderThickness="0" Width="16" Height="16">
                            <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Fill="{StaticResource NeonCyanBrush}" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Center Group: Title & Seek -->
                    <Grid Grid.Column="1" Margin="30,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="{Binding CurrentTrack.Title, FallbackValue='No Track Selected'}" 
                                   HorizontalAlignment="Left" Foreground="{DynamicResource TextForegroundBrush}" FontSize="14" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CurrentTimeDisplay}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            
                            <Slider Grid.Column="1" Value="{Binding Progress, Mode=TwoWay}" Maximum="100" VerticalAlignment="Center" 
                                    IsMoveToPointEnabled="True"
                                    Thumb.DragStarted="Slider_DragStarted"
                                    Thumb.DragCompleted="Slider_DragCompleted"
                                    Style="{StaticResource NeonSliderStyle}"/>
                                    
                            <TextBlock Grid.Column="2" Text="{Binding TotalTimeDisplay}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Grid>

                    <!-- Right Group: Fav & Add & Settings -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ShowSettingsCommand}" Margin="0,0,15,0" Background="Transparent" BorderThickness="0" ToolTip="Settings">
                            <Path Data="M19.43 12.98c.04-.32.07-.64.07-.98 0-.34-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98 0 .33.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z" Fill="{DynamicResource MutedTextForegroundBrush}" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button Command="{Binding ShowAddToPlaylistDialogCommand}" CommandParameter="{Binding CurrentTrack}" Margin="0,0,15,0" Background="Transparent" BorderThickness="0" ToolTip="Add to Playlist">
                            <Path Data="M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6V13z" Fill="{DynamicResource MutedTextForegroundBrush}" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding CurrentTrack}" Background="Transparent" BorderThickness="0" ToolTip="Favorite">
                            <Path Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" 
                                  Width="16" Height="16" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#606060"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentTrack.IsFavorite}" Value="True">
                                                <Setter Property="Fill" Value="#FF4081"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource ControlBackgroundBrush}"/>

            <!-- Bottom Section: EQ + Presets + Device Sync -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Tabs -->
                    <RowDefinition Height="*"/> <!-- Content -->
                </Grid.RowDefinitions>

                <!-- Tabs -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource PanelBackgroundBrush}">
                    <Button Content="SPECTRUM" Command="{Binding SwitchToSpectrumCommand}" Width="150" Height="30" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#808080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSpectrumVisible}" Value="True">
                                        <Setter Property="Background" Value="#303030"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="EQUALIZER" Command="{Binding SwitchToEqualizerCommand}" Width="150" Height="30" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#808080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEqualizerVisible}" Value="True">
                                        <Setter Property="Background" Value="#303030"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="DEVICE SYNC" Command="{Binding SwitchToDeviceSyncCommand}" IsEnabled="{Binding IsDeviceConnected}" Width="150" Height="30" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#808080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceSyncVisible}" Value="True">
                                        <Setter Property="Background" Value="#303030"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Spectrum Analyzer View -->
                <Grid Grid.Row="1" Visibility="{Binding IsSpectrumVisible, Converter={StaticResource BoolToVis}}" ClipToBounds="True">
                    <!-- 1. The Mask Source (Must be opaque and visible for VisualBrush to work) -->
                    <!-- Placed BEHIND the Background Image (first child) so it's hidden from view but still rendered -->
                    <ItemsControl x:Name="SpectrumMaskItemsControl" ItemsSource="{Binding SpectrumValues}" Margin="20,10" RenderOptions.EdgeMode="Aliased">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="2,0">
                                    <Border Background="{Binding DataContext.SpectrumBarBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            Height="{Binding Value}" MaxHeight="600" MinHeight="2" CornerRadius="2"
                                            BorderBrush="{Binding DataContext.SpectrumBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderThickness="{Binding Value, Converter={StaticResource HeightToBorderThickness}}"
                                            Opacity="{Binding Value, Converter={StaticResource ZeroToTransparent}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{Binding DataContext.SpectrumShadowColor, RelativeSource={RelativeSource AncestorType=Window}}" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Background Album Art -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDefaultSpectrumImage}" Value="False">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="10"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- Color Image (Base) -->
                        <Image Source="{Binding SpectrumBackgroundImage}" Stretch="UniformToFill" VerticalAlignment="Center"/>
                        
                        <!-- Grayscale Overlay (Partial Desaturation) -->
                        <Image Source="{Binding SpectrumBackgroundImageGray}" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.8">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefaultSpectrumImage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!-- Darkening Overlay -->
                        <Rectangle Fill="Black" Opacity="0.75">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefaultSpectrumImage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Grid>

                    <!-- Global Gradient Spectrum Bars using OpacityMask -->
                    <Grid Margin="20,10" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                        <!-- 2. The Gradient Layer (Visible only where Mask allows) -->
                        <Rectangle Fill="{Binding SpectrumBarBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Rectangle.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=SpectrumMaskItemsControl}" />
                            </Rectangle.OpacityMask>
                            <Rectangle.Effect>
                                <DropShadowEffect Color="{Binding SpectrumShadowColor}" BlurRadius="40" ShadowDepth="0" Opacity="1.0"/>
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                </Grid>

                <!-- Equalizer View -->
                <Grid Grid.Row="1" Visibility="{Binding IsEqualizerVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid VerticalAlignment="Center" Margin="20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/> <!-- Volume Control -->
                        </Grid.ColumnDefinitions>
                        
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Bands}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="10" Margin="0,0,0,10"/>
                                        <Slider Grid.Row="1" Style="{StaticResource NeonVerticalSliderStyle}" Orientation="Vertical" Minimum="-10" Maximum="10" Value="{Binding Gain}" MinHeight="225"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Volume Control -->
                        <Grid Grid.Column="1" Margin="20,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/> <!-- Top Spacer -->
                                <RowDefinition Height="Auto"/> <!-- + Button -->
                                <RowDefinition Height="Auto"/> <!-- Slider -->
                                <RowDefinition Height="Auto"/> <!-- - Button -->
                                <RowDefinition Height="*"/> <!-- Bottom Spacer -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="VOL" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="10" Margin="0,0,0,10"/>

                            <StackPanel Grid.Row="2" Grid.RowSpan="3" VerticalAlignment="Center">
                                <Button Command="{Binding IncreaseVolumeCommand}" Content="+" Width="30" Height="30" 
                                        Background="Transparent" Foreground="{StaticResource NeonVolumeBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                
                                <Slider Style="{StaticResource NeonVolumeSliderStyle}" Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding Volume}" 
                                        MinHeight="180" HorizontalAlignment="Center"/>
                                
                                <Button Command="{Binding DecreaseVolumeCommand}" Content="-" Width="30" Height="30" 
                                        Background="Transparent" Foreground="{StaticResource NeonVolumeBrush}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>

                                <TextBlock Text="{Binding VolumePercent}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Presets Control -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20">
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Width="200" Height="30" Margin="0,0,10,0"
                                  Style="{StaticResource NeonComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextForegroundBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Background" Value="#404040"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="5,2">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#606060"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>
                        <Button Content="SAVE" Command="{Binding SavePresetCommand}" Width="80" Height="30" Margin="0,0,10,0" Background="{DynamicResource ControlBackgroundHighlightBrush}"/>
                        <Button Content="RESET" Command="{Binding ResetPresetCommand}" Width="80" Height="30" Margin="0,0,10,0" Background="{DynamicResource ControlBackgroundHighlightBrush}"/>
                        <Button Content="DELETE" Command="{Binding DeletePresetCommand}" Width="80" Height="30" Background="#8B0000"/>
                    </StackPanel>
                </Grid>

                <!-- Device Sync View -->
                <Grid Grid.Row="1" Visibility="{Binding IsDeviceSyncVisible, Converter={StaticResource BoolToVis}}" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Device Selection -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="CONNECTED DEVICE:" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="12" Margin="0,0,0,5"/>
                        
                        <!-- Device ComboBox -->
                        <Grid Margin="0,0,0,10" IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding RemovableDrives}" SelectedItem="{Binding SelectedDevice}" 
                                      Height="30"
                                      Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="0" VerticalContentAlignment="Center" Padding="5,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextForegroundBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#303030"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                            
                            <!-- Manage Device Button -->
                            <Button Grid.Column="1" Content="⚙ Manage" Command="{Binding ShowDeviceManagerCommand}"
                                    ToolTip="Open Device Storage Manager"
                                    Height="30" Margin="5,0,0,0" Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="0" Padding="10,0"/>
                        </Grid>

                        <!-- Navigation Bar -->
                        <Grid Margin="0,0,0,5" IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content=".." Command="{Binding NavigateUpCommand}" Width="30" Height="25" Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CurrentDevicePath}" Grid.Column="1" Foreground="{DynamicResource SecondaryTextForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Content="↻" Command="{Binding RefreshDirectoryCommand}" Width="30" Height="25" Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}" ToolTip="Refresh"/>
                        </Grid>

                        <!-- Folder List -->
                        <ListBox ItemsSource="{Binding DeviceDirectories}" Height="150" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,10"
                                 IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.NavigateDirectoryCommand, ElementName=MainWindowRoot}" CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁" Foreground="#FFD700" Margin="0,0,5,0" 
                                                       Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="📄" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,0,5,0" 
                                                       Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextForegroundBrush}" Padding="2"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid>
                            <TextBlock Text="{Binding TransferProgress, StringFormat='Transferring: {0:0}%'}" Foreground="{DynamicResource TextForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="10"/>
                        </Grid>
                        
                        <Button Command="{Binding TransferSelectedCommand}" Height="50" Background="{StaticResource NeonCyanBrush}" IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransferring}" Value="True">
                                            <Setter Property="Background" Value="#404040"/>
                                            <Setter Property="Foreground" Value="#AAAAAA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <TextBlock Text="TRANSFER SELECTED" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                <TextBlock Text="TRANSFERRING..." FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
