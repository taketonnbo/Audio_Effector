<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Colors (Modern Deep Slate & Premium Charcoal Palette) -->
    <Color x:Key="WindowBackgroundColor">#161920</Color>
    <Color x:Key="PanelBackgroundColor">#1B2028</Color>
    <Color x:Key="ControlBackgroundColor">#232934</Color>
    <Color x:Key="ControlBackgroundHighlightColor">#2F3746</Color>
    
    <Color x:Key="TextForegroundColor">#F0F4F8</Color>
    <Color x:Key="SecondaryTextForegroundColor">#A0AEC0</Color>
    <Color x:Key="MutedTextForegroundColor">#718096</Color>
    
    <Color x:Key="BorderColor">#343E4E</Color>
    
    <!-- Accent Colors (Shared or Theme Specific) -->
    <Color x:Key="NeonCyanColor">#00FFFF</Color>
    <Color x:Key="DarkNeonCyanColor">#00E5FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundHighlightBrush" Color="{StaticResource ControlBackgroundHighlightColor}"/>
    
    <SolidColorBrush x:Key="TextForegroundBrush" Color="{StaticResource TextForegroundColor}"/>
    <SolidColorBrush x:Key="SecondaryTextForegroundBrush" Color="{StaticResource SecondaryTextForegroundColor}"/>
    <SolidColorBrush x:Key="MutedTextForegroundBrush" Color="{StaticResource MutedTextForegroundColor}"/>
    
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    
    <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyanColor}"/>
    <SolidColorBrush x:Key="DarkNeonCyanBrush" Color="{StaticResource DarkNeonCyanColor}"/>

    <!-- Metallic Card Background & Border Brushes (Top-Left Light, Bottom-Right Dark) -->
    <LinearGradientBrush x:Key="MetallicCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C3545" Offset="0.0"/>
        <GradientStop Color="#202734" Offset="0.45"/>
        <GradientStop Color="#161A22" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MetallicCardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#687B99" Offset="0.0"/>
        <GradientStop Color="#384556" Offset="0.5"/>
        <GradientStop Color="#1A2028" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Zebra Stripe Brush (Subtle dynamic white for Dark Theme) -->
    <SolidColorBrush x:Key="ZebraOddBackgroundBrush" Color="#12FFFFFF"/>

    <!-- Dynamic Theme Drop Shadows (Dark Theme: ~2x Opacity for Deep Slate Contrast) -->
    <DropShadowEffect x:Key="CardDropShadowEffect" Color="#000000" BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.75"/>
    <DropShadowEffect x:Key="AlbumArtDropShadowEffect" Color="#000000" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.85"/>

</ResourceDictionary>
