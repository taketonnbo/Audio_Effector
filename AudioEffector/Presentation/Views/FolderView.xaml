<UserControl x:Class="AudioEffector.Presentation.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
             xmlns:converters="clr-namespace:AudioEffector.Presentation.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BoolToVisConverter x:Key="BoolToVis"/>
        <converters:NullToVisConverter x:Key="NullToVis"/>
        <!-- Primary Action Button Style (Neon Cyan Filled) -->
        <Style x:Key="FolderPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource DarkNeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button Style (Surface with Border & Cyan Hover) -->
        <Style x:Key="FolderSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline Neon Button Style (SELECT FOLDER) -->
        <Style x:Key="FolderOutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <!-- Header -->
            <TextBlock Text="フォルダ管理・ライブラリ同期"
                       Foreground="{DynamicResource TextForegroundBrush}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="音楽フォルダを選択または再スキャンし、追加・削除されたアルバムや楽曲をライブラリに同期します。"
                       Foreground="{DynamicResource MutedTextForegroundBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- Current Folder Card -->
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="現在の指定済みフォルダ"
                               Foreground="{DynamicResource MutedTextForegroundBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Border Background="{DynamicResource ControlBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <TextBlock x:Name="CurrentFolderPathTextBlock"
                                   Text="{Binding DisplayFolderPath, Mode=OneWay}"
                                   ToolTip="{Binding CurrentFolderPath, Mode=OneWay}"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button x:Name="SelectFolderButton"
                            Content="SELECT FOLDER"
                            Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource FolderOutlineButtonStyle}"
                            HorizontalAlignment="Stretch"
                            ToolTip="スキャン対象フォルダを選択・変更します"/>
                </StackPanel>
            </Border>

            <!-- Scan Action Buttons -->
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ライブラリスキャン操作"
                               Foreground="{DynamicResource MutedTextForegroundBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ScanNewFolderButton"
                                Grid.Column="0"
                                Content="フォルダを指定してスキャン"
                                Command="{Binding ScanNewFolderCommand}"
                                Style="{StaticResource FolderSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                ToolTip="フォルダ選択ダイアログを開き、新たに指定したフォルダをスキャン・登録します"/>

                        <Button x:Name="RescanCurrentFolderButton"
                                Grid.Column="2"
                                Content="指定済みのフォルダをスキャン"
                                Command="{Binding RescanCurrentFolderCommand}"
                                Style="{StaticResource FolderPrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                ToolTip="現在指定されているフォルダを再スキャンし、追加・削除された楽曲を同期します"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Scan Progress Indicator & Status Area -->
            <Border x:Name="ScanProgressPanel"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="ライブラリをスキャン中..."
                                   Foreground="{DynamicResource NeonCyanBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ScanProgressPercent, StringFormat='{}{0}%', Mode=OneWay}"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar x:Name="ScanProgressBar"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding ScanProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsIndeterminateProgress, Mode=OneWay}"
                                 Height="6"
                                 Foreground="{DynamicResource NeonCyanBrush}"
                                 Background="{DynamicResource ControlBackgroundHighlightBrush}"
                                 BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Status Message Banner -->
            <Border x:Name="ScanStatusBanner"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Visibility="{Binding ScanStatusText, Converter={StaticResource NullToVis}}">
                <TextBlock x:Name="ScanStatusTextBlock"
                           Text="{Binding ScanStatusText, Mode=OneWay}"
                           Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
