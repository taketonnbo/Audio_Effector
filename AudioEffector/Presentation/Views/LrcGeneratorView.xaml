<UserControl x:Class="AudioEffector.Presentation.Views.LrcGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:AudioEffector.Presentation.ViewModels"
             mc:Ignorable="d"
             x:Name="LrcGeneratorViewRoot"
             MinWidth="260"
             MinHeight="220"
             d:DesignHeight="420"
             d:DesignWidth="440"
             d:DataContext="{d:DesignInstance vm:LrcGeneratorViewModel}">
    <UserControl.Resources>
        <!-- PrimaryButton -->
        <Style x:Key="LrcPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource DarkNeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SecondaryButton -->
        <Style x:Key="LrcSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AccentOutlineButton（音声から直接文字起こし用独立ボタン） -->
        <Style x:Key="LrcAccentSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LrcSecondaryButtonStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SubtleButton -->
        <Style x:Key="LrcSubtleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.85"/>
                                <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- オフセット調整用コンパクトボタン -->
        <Style x:Key="LrcOffsetButtonStyle" TargetType="Button" BasedOn="{StaticResource LrcSecondaryButtonStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- 進捗バー（角丸 4px・確定／不定両モード対応） -->
        <Style x:Key="LrcProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"/>
                            <Grid x:Name="PART_Indicator"
                                  HorizontalAlignment="Left"
                                  ClipToBounds="True">
                                <Border Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"/>
                                <Border x:Name="PART_GlowRect"
                                        Width="64"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"
                                        Opacity="0.65"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- プレビュー ListBox 用テンプレート（仮想化維持・ItemsPresenter.Margin=0 厳守） -->
        <ControlTemplate x:Key="LrcPreviewListBoxTemplate" TargetType="ListBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ScrollViewer"
                              Focusable="False"
                              Padding="0"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter x:Name="PART_ItemsPresenter"
                                    Margin="0"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ScrollViewer>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <!-- 外側コンテナ -->
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: ヘッダー (36px) -->
                <RowDefinition Height="Auto"/> <!-- Row 1: モデルバー / オフセットバー -->
                <RowDefinition Height="*"/>    <!-- Row 2: 6排他状態コンテンツ領域 -->
                <RowDefinition Height="Auto"/> <!-- Row 3: 上書き確認バー＋フッター -->
            </Grid.RowDefinitions>

            <!-- Row 0: パネルヘッダー -->
            <Border Grid.Row="0"
                    Height="36"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M19,9L20.25,6.25L23,5L20.25,3.75L19,1L17.75,3.75L15,5L17.75,6.25L19,9M19,15L17.75,17.75L15,19L17.75,20.25L19,23L20.25,20.25L23,19L20.25,17.75L19,15M11.5,9.5L9,4L6.5,9.5L1,12L6.5,14.5L9,20L11.5,14.5L17,12L11.5,9.5Z"
                              Fill="{DynamicResource NeonCyanBrush}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="LRC 自動生成"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TargetTrackDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,8,0"
                               ToolTip="{Binding TargetTrackDisplay}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackToLyricsButton"
                                Content="← 歌詞へ戻る"
                                Style="{StaticResource LrcSubtleButtonStyle}"
                                Command="{Binding BackToLyricsCommand}"
                                Height="28"
                                Margin="0,0,4,0"
                                ToolTip="同期歌詞表示へ戻る"
                                AutomationProperties.Name="同期歌詞表示へ戻る"/>
                        <Button x:Name="CloseGeneratorButton"
                                Content="✕"
                                Style="{StaticResource LrcSubtleButtonStyle}"
                                Command="{Binding CloseGeneratorCommand}"
                                Width="28"
                                Height="28"
                                Padding="0"
                                ToolTip="パネルを閉じる"
                                AutomationProperties.Name="LRC自動生成パネルを閉じる"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: 状態別ツールバー -->
            <Grid Grid.Row="1">
                <!-- 1-A: モデルステータス＆言語選択バー（入力待機状態のみ表示） -->
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        Visibility="{Binding IsInputState, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveModelDisplay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModelStatusBadgeText}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource NeonCyanBrush}"/>
                            </Border>

                            <TextBlock Text="言語:"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{DynamicResource NeonComboBoxStyle}"
                                      Width="112"
                                      Height="24"
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="音声認識言語選択"/>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="モデル指定"
                                    Style="{StaticResource LrcSubtleButtonStyle}"
                                    Command="{Binding SelectCustomModelFileCommand}"
                                    ToolTip="配置済みのローカルモデルファイル (.bin) を指定"
                                    AutomationProperties.Name="ローカルモデルファイル指定"/>
                            <Button Content="再DL"
                                    Style="{StaticResource LrcSubtleButtonStyle}"
                                    Command="{Binding DownloadDefaultModelCommand}"
                                    ToolTip="無料の標準 Whisper モデル (base) をダウンロード"
                                    AutomationProperties.Name="標準モデルを再ダウンロード"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1-B: 全体オフセット調整ツールバー（結果プレビュー状態のみ表示） -->
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        Visibility="{Binding IsPreviewState, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="オフセット:"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Button Content="-0.5s" Style="{StaticResource LrcOffsetButtonStyle}" Command="{Binding AdjustOffsetCommand}" CommandParameter="-0.5"/>
                            <Button Content="-0.1s" Style="{StaticResource LrcOffsetButtonStyle}" Command="{Binding AdjustOffsetCommand}" CommandParameter="-0.1"/>
                            <Button Content="+0.1s" Style="{StaticResource LrcOffsetButtonStyle}" Command="{Binding AdjustOffsetCommand}" CommandParameter="0.1"/>
                            <Button Content="+0.5s" Style="{StaticResource LrcOffsetButtonStyle}" Command="{Binding AdjustOffsetCommand}" CommandParameter="0.5"/>
                            <Button Content="リセット" Style="{StaticResource LrcOffsetButtonStyle}" Command="{Binding ResetOffsetCommand}"/>
                            <TextBlock Text="{Binding OffsetDisplayText}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource NeonCyanBrush}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </WrapPanel>

                        <Button Grid.Column="1"
                                Content="↺ 再生成"
                                Style="{StaticResource LrcSubtleButtonStyle}"
                                Command="{Binding RegenerateCommand}"
                                VerticalAlignment="Center"
                                ToolTip="入力画面へ戻って再生成する"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 2: 6排他状態メインコンテンツ領域 -->
            <Grid Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}">

                <!-- 状態 1: モデル未配置ガイド -->
                <Grid Visibility="{Binding IsModelMissingState, Converter={StaticResource BoolToVis}}"
                      Margin="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="ローカル解析モデルが未配置です"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="無料・MIT ライセンスのオフライン Whisper モデル (base / 約 142MB) をダウンロードするか、配置済みモデルファイル (.bin) を指定してください。"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding ValidationErrorMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource NeonCyanBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}"/>

                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="標準モデルをダウンロード"
                                    Style="{StaticResource LrcPrimaryButtonStyle}"
                                    Command="{Binding DownloadDefaultModelCommand}"
                                    Margin="0,0,8,8"
                                    AutomationProperties.Name="標準Whisperモデルをダウンロード"/>
                            <Button Content="配置済みモデル (.bin) を指定"
                                    Style="{StaticResource LrcSecondaryButtonStyle}"
                                    Command="{Binding SelectCustomModelFileCommand}"
                                    Margin="0,0,0,8"
                                    AutomationProperties.Name="配置済みモデルファイルを指定"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <!-- 状態 2: モデルダウンロード中 -->
                <Grid Visibility="{Binding IsModelDownloadingState, Converter={StaticResource BoolToVis}}"
                      Margin="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                        <TextBlock Text="モデルをダウンロード中..."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <ProgressBar Value="{Binding ModelDownloadProgress, Mode=OneWay}"
                                     Minimum="0"
                                     Maximum="100"
                                     Style="{StaticResource LrcProgressBarStyle}"
                                     Margin="0,0,0,8"
                                     AutomationProperties.Name="モデルダウンロード進捗"/>
                        <TextBlock Text="{Binding ModelDownloadStatusMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <Button x:Name="CancelModelDownloadButton"
                                Style="{StaticResource LrcSecondaryButtonStyle}"
                                Command="{Binding CancelModelDownloadCommand}"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="モデルダウンロードをキャンセル">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="キャンセル"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCancelling}" Value="True">
                                                    <Setter Property="Text" Value="キャンセル中..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 状態 3: 入力・待機状態（2つの独立した生成モード＋非UTF-8警告インラインバー併存） -->
                <ScrollViewer Visibility="{Binding IsInputState, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <!-- セクション 1: テキストファイル (.txt) から生成 -->
                        <TextBlock Text="1. テキストファイル (.txt) から LRC を生成"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   Margin="0,0,0,8"/>

                        <!-- .txt ドロップゾーン -->
                        <Border x:Name="TextFileDropZone"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                AllowDrop="True"
                                Cursor="Hand"
                                PreviewDragOver="TextFileDropZone_PreviewDragOver"
                                DragLeave="TextFileDropZone_DragLeave"
                                Drop="TextFileDropZone_Drop"
                                MouseLeftButtonUp="TextFileDropZone_MouseLeftButtonUp"
                                ToolTip="クリックして .txt を選択、またはドラッグ＆ドロップ"
                                AutomationProperties.Name="歌詞テキストファイルドロップ領域">
                            <Grid>
                                <!-- 未選択時表示 -->
                                <StackPanel Visibility="{Binding HasInputTextFile, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <TextBlock Text="UTF-8 歌詞テキスト (.txt) をドラッグ＆ドロップ、またはクリックして選択"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Shift-JIS 等の非 UTF-8 ファイルは警告後に承諾を得て UTF-8 変換します（元ファイルは変更しません）"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextForegroundBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 選択済み時表示 -->
                                <Grid Visibility="{Binding HasInputTextFile, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InputTextFileName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding InputTextSummary}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="変更"
                                                Style="{StaticResource LrcSubtleButtonStyle}"
                                                Command="{Binding SelectTextFileCommand}"
                                                Margin="4,0,0,0"/>
                                        <Button Content="✕"
                                                Style="{StaticResource LrcSubtleButtonStyle}"
                                                Command="{Binding ClearTextFileCommand}"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                Margin="4,0,0,0"
                                                ToolTip="ファイル選択を解除"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 対象楽曲の音声ファイル欠損通知（インライン・テキスト選択エラーとは独立） -->
                        <Border x:Name="TargetAudioMissingBanner"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsTargetAudioMissing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TargetAudioMissingMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource NeonCyanBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- 開始前バリデーション通知（インライン） -->
                        <Border Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ValidationErrorMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource NeonCyanBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- 非 UTF-8 警告・変換承諾インラインバー（ドロップゾーン直下に併存） -->
                        <Border x:Name="EncodingWarningBanner"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsEncodingWarningVisible, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource NeonCyanBrush}" CornerRadius="2,0,0,2"/>
                                <StackPanel Grid.Column="1" Margin="12">
                                    <TextBlock Text="{Binding DetectedEncodingName, StringFormat='⚠ {0} が検出されました'}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextForegroundBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding EncodingWarningMessage}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button x:Name="ConfirmEncodingButton"
                                                Content="UTF-8 に変換して続行"
                                                Style="{StaticResource LrcPrimaryButtonStyle}"
                                                Command="{Binding ConfirmEncodingConversionCommand}"
                                                Margin="0,0,8,0"/>
                                        <Button x:Name="CancelEncodingButton"
                                                Content="キャンセル"
                                                Style="{StaticResource LrcSecondaryButtonStyle}"
                                                Command="{Binding CancelEncodingConversionCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- モード A 実行ボタン: テキストから LRC を生成 -->
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="GenerateFromTextButton"
                                    Content="テキストから LRC を生成"
                                    Style="{StaticResource LrcPrimaryButtonStyle}"
                                    Command="{Binding GenerateLrcCommand}"
                                    ToolTip="選択した歌詞テキストと楽曲音声を自動同期して LRC を生成します"
                                    AutomationProperties.Name="テキストからLRCを生成"/>
                        </WrapPanel>

                        <!-- 区切り線 -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>

                        <!-- セクション 2: 音声から直接文字起こし（.txt 不要・独立別ボタン） -->
                        <TextBlock Text="2. 音声から直接文字起こし（.txt 不要）"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="歌詞テキストを用意せずに、楽曲音声そのものをローカル Whisper モデルで文字起こししてタイムタグ付き LRC を生成します。"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button x:Name="TranscribeAudioButton"
                                    Content="音声から文字起こしして LRC を生成"
                                    Style="{StaticResource LrcAccentSecondaryButtonStyle}"
                                    Command="{Binding TranscribeAudioCommand}"
                                    ToolTip="テキストファイルを使わず楽曲音声から直接文字起こしして LRC を生成します"
                                    AutomationProperties.Name="音声から文字起こししてLRCを生成"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 状態 4: 生成・文字起こし実行中 -->
                <Grid Visibility="{Binding IsGeneratingState, Converter={StaticResource BoolToVis}}"
                      Margin="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                        <TextBlock Text="{Binding CurrentPhaseLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                     Minimum="0"
                                     Maximum="100"
                                     Style="{StaticResource LrcProgressBarStyle}"
                                     Margin="0,0,0,8"
                                     AutomationProperties.Name="LRC生成進捗"/>
                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:0}%'}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource NeonCyanBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <Button x:Name="CancelGenerationButton"
                                Style="{StaticResource LrcSecondaryButtonStyle}"
                                Command="{Binding CancelGenerationCommand}"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="LRC生成をキャンセル">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="キャンセル"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCancelling}" Value="True">
                                                    <Setter Property="Text" Value="キャンセル中..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 状態 5: 結果プレビュー・簡易微調整（UI 仮想化 ListBox・親 ScrollViewer 禁止） -->
                <ListBox x:Name="PreviewLinesListBox"
                         Visibility="{Binding IsPreviewState, Converter={StaticResource BoolToVis}}"
                         ItemsSource="{Binding PreviewLines}"
                         AlternationCount="2"
                         Background="{DynamicResource WindowBackgroundBrush}"
                         BorderThickness="0"
                         Padding="0"
                         Template="{StaticResource LrcPreviewListBoxTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Margin="8,2"
                                                MouseLeftButtonUp="PreviewLineBorder_MouseLeftButtonUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="AccentBar"
                                                        Grid.Column="0"
                                                        Background="Transparent"
                                                        CornerRadius="2"/>
                                                <ContentPresenter Grid.Column="1" Margin="8,6"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ZebraOddBackgroundBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LrcPreviewLineViewModel}">
                            <Grid>
                                <!-- 通常表示行 -->
                                <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TimestampDisplay}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource NeonCyanBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextForegroundBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="2"
                                            Content="✎"
                                            Style="{StaticResource LrcSubtleButtonStyle}"
                                            Command="{Binding BeginEditCommand}"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            Margin="8,0,0,0"
                                            ToolTip="この行の時刻・テキストを編集"
                                            AutomationProperties.Name="行を編集"/>
                                </Grid>

                                <!-- 個別行インライン編集モード -->
                                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditingTimestampText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 Background="{DynamicResource ControlBackgroundBrush}"
                                                 Foreground="{DynamicResource TextForegroundBrush}"
                                                 CaretBrush="{DynamicResource NeonCyanBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="1"
                                                 Padding="4,3"
                                                 Margin="0,0,6,0"
                                                 KeyDown="EditTextBox_KeyDown"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding EditingLyricText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13"
                                                 Background="{DynamicResource ControlBackgroundBrush}"
                                                 Foreground="{DynamicResource TextForegroundBrush}"
                                                 CaretBrush="{DynamicResource NeonCyanBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="1"
                                                 Padding="6,3"
                                                 Margin="0,0,6,0"
                                                 KeyDown="EditTextBox_KeyDown"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="確定"
                                                    Style="{StaticResource LrcSubtleButtonStyle}"
                                                    Command="{Binding CommitEditCommand}"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="取消"
                                                    Style="{StaticResource LrcSubtleButtonStyle}"
                                                    Command="{Binding CancelEditCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding EditErrorMessage}"
                                               FontSize="11"
                                               Foreground="{DynamicResource NeonCyanBrush}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasEditError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 状態 6: エラー状態 -->
                <Grid Visibility="{Binding IsErrorState, Converter={StaticResource BoolToVis}}"
                      Margin="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="{Binding ErrorTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="再試行"
                                    Style="{StaticResource LrcPrimaryButtonStyle}"
                                    Command="{Binding RetryErrorCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="戻る"
                                    Style="{StaticResource LrcSecondaryButtonStyle}"
                                    Command="{Binding ReturnFromErrorCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Row 3: 結果プレビュー時の上書き確認インラインバー＋フッターアクションバー -->
            <StackPanel Grid.Row="3"
                        Visibility="{Binding IsPreviewState, Converter={StaticResource BoolToVis}}">
                <!-- 既存 .lrc 上書き確認インラインバー -->
                <Border x:Name="OverwriteConfirmBanner"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding IsOverwriteConfirmVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource NeonCyanBrush}"/>
                        <StackPanel Grid.Column="1" Margin="12,8">
                            <TextBlock Text="{Binding OverwriteWarningMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="上書き保存する"
                                        Style="{StaticResource LrcPrimaryButtonStyle}"
                                        Command="{Binding ConfirmOverwriteSaveCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Content="キャンセル"
                                        Style="{StaticResource LrcSecondaryButtonStyle}"
                                        Command="{Binding CancelOverwriteSaveCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 保存失敗エラーインラインバー -->
                <Border x:Name="SaveErrorBanner"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource NeonCyanBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SaveErrorMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource NeonCyanBrush}"
                                   TextWrapping="Wrap"
                                   Margin="12,8"/>
                    </Grid>
                </Border>

                <!-- フッターアクションバー -->
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DestinationFilePath, StringFormat='保存先: {0} (UTF-8)'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DestinationFilePath}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SaveCompletedMessage}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource NeonCyanBrush}"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding HasSaveCompletedMessage, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <WrapPanel>
                            <Button x:Name="SaveLrcButton"
                                    Content="LRC を保存"
                                    Style="{StaticResource LrcPrimaryButtonStyle}"
                                    Command="{Binding SaveLrcCommand}"
                                    Margin="0,0,8,4"
                                    AutomationProperties.Name="LRCファイルを保存"/>
                            <Button x:Name="OpenSavedFolderButton"
                                    Content="保存先フォルダを開く"
                                    Style="{StaticResource LrcSecondaryButtonStyle}"
                                    Command="{Binding OpenSavedFolderCommand}"
                                    Margin="0,0,8,4"
                                    AutomationProperties.Name="保存先フォルダを開く"/>
                            <Button Content="歌詞表示で確認"
                                    Style="{StaticResource LrcSubtleButtonStyle}"
                                    Command="{Binding BackToLyricsCommand}"
                                    Margin="0,0,0,4"
                                    AutomationProperties.Name="同期歌詞表示パネルで確認"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
