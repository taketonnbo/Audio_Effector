<UserControl x:Class="AudioEffector.Presentation.Views.PlaylistTracksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
             xmlns:services="clr-namespace:AudioEffector.Presentation.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Background Image (Blurred & Darkened) -->
                <Grid Grid.RowSpan="2" ClipToBounds="True">
                    <Image Source="{Binding PlaylistBackgroundImage}" Stretch="UniformToFill">
                        <Image.Effect>
                            <BlurEffect Radius="30"/>
                        </Image.Effect>
                    </Image>
                    <Rectangle Fill="#66000000"/> <!-- Reduced opacity (40%) for better visibility -->
                </Grid>
                
                <!-- Playlist Header -->
                <!-- Playlist Header -->
                <Grid Grid.Row="0" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                        <ColumnDefinition Width="*"/>    <!-- Title -->
                        <ColumnDefinition Width="Auto"/> <!-- Close Button -->
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                         <!-- Playlist Icon (Hide when Favorites) -->
                        <!-- Playlist Image Grid (Hide when Favorites) -->
                        <Border Width="40" Height="40" Margin="0,0,10,0" CornerRadius="4" ClipToBounds="True"
                                Visibility="{Binding IsFavoritesView, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="*"/>
                                     <RowDefinition Height="*"/>
                                 </Grid.RowDefinitions>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="*"/>
                                 </Grid.ColumnDefinitions>
                                 
                                 <Image Grid.Row="0" Grid.Column="0" services:AlbumArtLoader.SourcePath="{Binding CurrentViewingPlaylist.Thumbnail1}" Stretch="UniformToFill"/>
                                 <Image Grid.Row="0" Grid.Column="1" services:AlbumArtLoader.SourcePath="{Binding CurrentViewingPlaylist.Thumbnail2}" Stretch="UniformToFill"/>
                                 <Image Grid.Row="1" Grid.Column="1" services:AlbumArtLoader.SourcePath="{Binding CurrentViewingPlaylist.Thumbnail3}" Stretch="UniformToFill"/>
                                 <Image Grid.Row="1" Grid.Column="0" services:AlbumArtLoader.SourcePath="{Binding CurrentViewingPlaylist.Thumbnail4}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        
                        <!-- Favorites Icon (Show only when Favorites) -->
                        <Image Source="pack://application:,,,/Assets/Images/.png" Width="20" Height="20" Margin="0,0,10,0"
                               Visibility="{Binding IsFavoritesView, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding CurrentPlaylistName}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

                    <!-- Close Button (X) -->
                    <Button Grid.Column="2" Content="X" Command="{Binding ShowPlaylistSelectorCommand}"
                            Width="40" Height="40" Background="Transparent" BorderThickness="0" 
                            Foreground="{StaticResource NeonCyanBrush}" FontSize="18" FontWeight="Bold" ToolTip="Close Playlist"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                     <ItemsControl ItemsSource="{Binding PlaylistTracks}">
                         <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch" Margin="0,2" Background="Transparent" BorderThickness="0">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="再生" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                                    <Condition Binding="{Binding PlacementTarget.Tag.IsPlaying, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue=False}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Header" Value="停止" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="お気に入りに追加" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Header" Value="お気に入りから解除" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.Playlist.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="プロパティ" Command="{Binding PlacementTarget.Tag.ShowTrackPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="ファイルの場所を開く" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                            <ColumnDefinition Width="Auto"/> <!-- Album Art (Left) -->
                                            <ColumnDefinition Width="*"/>    <!-- Title/Artist -->
                                            <ColumnDefinition Width="Auto"/> <!-- Duration -->
                                            <ColumnDefinition Width="Auto"/> <!-- Remove Button -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                  Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                                  IsEnabled="{Binding DataContext.DeviceBrowser.IsTransferring, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertBool}}"/>

                                        <!-- Album Art (Moved to Left, Rounded Corners) -->
                                        <Border Grid.Column="1" Width="40" Height="40" Margin="0,0,10,0" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding AlbumArt}" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource SecondaryTextForegroundBrush}" FontSize="10"/>
                                        </StackPanel>
                                        
                                        <!-- Duration -->
                                        <TextBlock Grid.Column="3" Text="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}" Foreground="{DynamicResource SecondaryTextForegroundBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>

                                        <!-- Heart Removed -->

                                        <Button Grid.Column="4" Content="-" ToolTip="Remove from Playlist" 
                                                Command="{Binding DataContext.RemoveFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Width="40" Height="40" FontSize="24" FontWeight="Bold"
                                                Background="Transparent" Foreground="#FF4040" BorderThickness="0" Padding="0" Margin="0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                     </ItemsControl>
                </ScrollViewer>
            </Grid>

</UserControl>
