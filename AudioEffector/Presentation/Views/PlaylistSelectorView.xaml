<UserControl x:Class="AudioEffector.Presentation.Views.PlaylistSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
             xmlns:services="clr-namespace:AudioEffector.Presentation.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
            <Grid >
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                 </Grid.RowDefinitions>
                 <Button Grid.Row="0" Content="+ NEW PLAYLIST" Command="{Binding CreatePlaylistCommand}" 
                         HorizontalAlignment="Stretch" Margin="10,0,10,10" Background="{DynamicResource ControlBackgroundBrush}" Height="30"/>
                 <ListBox Grid.Row="1" ItemsSource="{Binding UserPlaylists}" Background="Transparent" BorderThickness="0" Margin="10,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                     <ListBox.ContextMenu>
                         <ContextMenu>
                             <MenuItem Header="新規プレイリスト作成" Command="{Binding PlacementTarget.Tag.CreatePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}"/>
                         </ContextMenu>
                     </ListBox.ContextMenu>
                     <ListBox.ItemsPanel>
                         <ItemsPanelTemplate>
                             <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                         </ItemsPanelTemplate>
                     </ListBox.ItemsPanel>
                     <ListBox.ItemContainerStyle>
                         <Style TargetType="ListBoxItem">
                             <Setter Property="Padding" Value="0"/>
                             <Setter Property="Margin" Value="10"/>
                             <Setter Property="Background" Value="Transparent"/>
                             <Setter Property="Template">
                                 <Setter.Value>
                                     <ControlTemplate TargetType="ListBoxItem">
                                         <ContentPresenter/>
                                     </ControlTemplate>
                                 </Setter.Value>
                             </Setter>
                         </Style>
                     </ListBox.ItemContainerStyle>
                     <ListBox.ItemTemplate>
                         <DataTemplate>
                             <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Command="{Binding DataContext.ShowPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="{Binding}"
                                     Width="160" Height="200" Background="{DynamicResource ControlBackgroundBrush}" BorderThickness="0" Margin="0">
                                 <Button.ContextMenu>
                                     <ContextMenu>
                                         <MenuItem Header="再生" Command="{Binding PlacementTarget.Tag.PlayPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                         <MenuItem Header="シャッフル再生" Command="{Binding PlacementTarget.Tag.ShufflePlayPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                         <Separator/>
                                         <MenuItem Header="名前の変更" Command="{Binding PlacementTarget.Tag.RenamePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                         <Separator/>
                                         <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}" CommandParameter="{Binding}"/>
                                     </ContextMenu>
                                 </Button.ContextMenu>
                                 <Button.Template>
                                     <ControlTemplate TargetType="Button">
                                         <Border Background="{TemplateBinding Background}" CornerRadius="8" ClipToBounds="True">
                                             <Grid>
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="160"/> <!-- Thumbnails (Square) -->
                                                     <RowDefinition Height="*"/>    <!-- Info -->
                                                 </Grid.RowDefinitions>

                                                 <!-- 2x2 Thumbnail Grid (Clockwise: TL->TR->BR->BL) -->
                                                 <Grid Grid.Row="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Index 0: TL -->
                                                    <Image Grid.Row="0" Grid.Column="0" services:AlbumArtLoader.SourcePath="{Binding Thumbnail1}" Stretch="UniformToFill"/>
                                                    <!-- Index 1: TR -->
                                                    <Image Grid.Row="0" Grid.Column="1" services:AlbumArtLoader.SourcePath="{Binding Thumbnail2}" Stretch="UniformToFill"/>
                                                    <!-- Index 2: BR -->
                                                    <Image Grid.Row="1" Grid.Column="1" services:AlbumArtLoader.SourcePath="{Binding Thumbnail3}" Stretch="UniformToFill"/>
                                                    <!-- Index 3: BL -->
                                                    <Image Grid.Row="1" Grid.Column="0" services:AlbumArtLoader.SourcePath="{Binding Thumbnail4}" Stretch="UniformToFill"/>
                                                 </Grid>

                                                 <!-- Info Area -->
                                                 <Grid Grid.Row="1" Margin="10,0">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>
                                                     <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                     
                                                     <!-- Delete Button (-) -->
                                                     <Button Grid.Column="1" Content="-" 
                                                             Command="{Binding DataContext.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"
                                                             Width="20" Height="20" Background="Transparent" Foreground="#FF4040" 
                                                             FontSize="18" FontWeight="Bold" Margin="5,0,0,0" BorderThickness="0" Padding="0"/>
                                                 </Grid>
                                             </Grid>
                                         </Border>
                                         <ControlTemplate.Triggers>
                                             <Trigger Property="IsMouseOver" Value="True">
                                                 <Setter Property="Background" Value="#303030"/>
                                             </Trigger>
                                         </ControlTemplate.Triggers>
                                     </ControlTemplate>
                                 </Button.Template>
                             </Button>
                         </DataTemplate>
                     </ListBox.ItemTemplate>
                 </ListBox>
            </Grid>


</UserControl>
