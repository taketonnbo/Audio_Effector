<Window x:Class="AudioEffector.Presentation.Views.DataMigrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="データ保存先の変更"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextForegroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="既存データの移行方法を選択してください"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource NeonCyanBrush}"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="現在の保存先に既存のデータファイル（プレイリスト・お気に入り・再生履歴・プリセット等）が存在します。"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextForegroundBrush}"
                       Margin="0,0,0,10"/>

            <Border Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="変更前:" FontSize="12" Foreground="{DynamicResource SecondaryTextForegroundBrush}"/>
                    <TextBlock x:Name="SourceDirectoryTextBlock"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               Margin="0,2,0,8"/>
                    <TextBlock Text="変更後:" FontSize="12" Foreground="{DynamicResource SecondaryTextForegroundBrush}"/>
                    <TextBlock x:Name="TargetDirectoryTextBlock"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border x:Name="DestinationOverwriteWarningBorder"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="{DynamicResource ControlBackgroundHighlightBrush}"
                BorderBrush="{DynamicResource NeonCyanBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12">
            <TextBlock x:Name="DestinationOverwriteWarningTextBlock"
                       Text="⚠ 変更先フォルダにはすでに既存のデータファイルが存在します。「コピーして切り替え」または「移動して切り替え」を選択すると、変更先の同名ファイルは上書きされます。変更先の既存データ（クラウド同期データ等）を使用する場合は「移行せず切り替え」を選択してください。"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextForegroundBrush}"/>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="※ アプリ設定（settings.json）は既定フォルダに残ります。"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button x:Name="CopyButton"
                    Content="コピーして切り替え"
                    IsDefault="True"
                    Click="CopyButton_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Background="{DynamicResource NeonCyanBrush}"
                    Foreground="{DynamicResource InverseTextForegroundBrush}"
                    FontWeight="SemiBold"
                    BorderThickness="0"/>
            <Button x:Name="MoveButton"
                    Content="移動して切り替え"
                    Click="MoveButton_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Background="{DynamicResource ControlBackgroundHighlightBrush}"
                    Foreground="{DynamicResource TextForegroundBrush}"
                    BorderThickness="0"/>
            <Button x:Name="SwitchOnlyButton"
                    Content="移行せず切り替え"
                    Click="SwitchOnlyButton_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Background="{DynamicResource ControlBackgroundHighlightBrush}"
                    Foreground="{DynamicResource TextForegroundBrush}"
                    BorderThickness="0"/>
            <Button x:Name="CancelButton"
                    Content="キャンセル"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Padding="12,6"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Foreground="{DynamicResource TextForegroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"/>
        </WrapPanel>
    </Grid>
</Window>
