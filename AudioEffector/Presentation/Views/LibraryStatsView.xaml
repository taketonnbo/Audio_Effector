<UserControl x:Class="AudioEffector.Presentation.Views.LibraryStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:AudioEffector.Domain.Entities;assembly=AudioEffector.Domain"
             xmlns:vm="clr-namespace:AudioEffector.Presentation.ViewModels"
             xmlns:services="clr-namespace:AudioEffector.Presentation.AttachedProperties"
             mc:Ignorable="d"
             x:Name="LibraryStatsViewRoot"
             d:DesignHeight="820" d:DesignWidth="1040"
             d:DataContext="{d:DesignInstance vm:LibraryStatsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LocalBoolToVis"/>

        <!-- プライマリアクションボタン -->
        <Style x:Key="StatsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セカンダリアクションボタン -->
        <Style x:Key="StatsSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セグメント切替ラジオボタンスタイル -->
        <Style x:Key="StatsSegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- カード内コンパクト切替ラジオボタンスタイル -->
        <Style x:Key="StatsCompactToggleRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource StatsSegmentRadioButtonStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- ランキング行クリック用ボタンスタイル -->
        <Style x:Key="StatsRankingRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 軽量フラットゲージバー -->
        <Style x:Key="StatsGaugeProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="2"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 上部ヘッダー（タイトル・期間フィルタ・クイックアクション / 狭幅折り返し対応） -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 画面タイトル -->
                <StackPanel VerticalAlignment="Center" Margin="0,2,20,2">
                    <TextBlock Text="リスニング統計"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextForegroundBrush}"/>
                    <TextBlock Text="{Binding SelectedPeriodDisplayName, StringFormat='対象期間: {0}'}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 期間フィルタ（今週 / 今月 / 今年 / 全期間） -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,4,16,4">
                    <RadioButton x:Name="PeriodThisWeekButton"
                                 Content="今週"
                                 GroupName="LibraryStatsPeriodFilter"
                                 Style="{StaticResource StatsSegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsThisWeekSelected, Mode=OneWay}"
                                 Command="{Binding SelectPeriodFilterCommand}"
                                 CommandParameter="{x:Static domain:StatsPeriodFilter.ThisWeek}"/>
                    <RadioButton x:Name="PeriodThisMonthButton"
                                 Content="今月"
                                 GroupName="LibraryStatsPeriodFilter"
                                 Style="{StaticResource StatsSegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsThisMonthSelected, Mode=OneWay}"
                                 Command="{Binding SelectPeriodFilterCommand}"
                                 CommandParameter="{x:Static domain:StatsPeriodFilter.ThisMonth}"/>
                    <RadioButton x:Name="PeriodThisYearButton"
                                 Content="今年"
                                 GroupName="LibraryStatsPeriodFilter"
                                 Style="{StaticResource StatsSegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsThisYearSelected, Mode=OneWay}"
                                 Command="{Binding SelectPeriodFilterCommand}"
                                 CommandParameter="{x:Static domain:StatsPeriodFilter.ThisYear}"/>
                    <RadioButton x:Name="PeriodAllTimeButton"
                                 Content="全期間"
                                 GroupName="LibraryStatsPeriodFilter"
                                 Style="{StaticResource StatsSegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsAllTimeSelected, Mode=OneWay}"
                                 Command="{Binding SelectPeriodFilterCommand}"
                                 CommandParameter="{x:Static domain:StatsPeriodFilter.AllTime}"
                                 Margin="0"/>
                </StackPanel>

                <!-- クイックアクション -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,4,0,4">
                    <Button x:Name="PlayTopTracksButton"
                            Content="▶ TOP 10 を再生"
                            Style="{StaticResource StatsPrimaryButtonStyle}"
                            Command="{Binding PlayTopTracksCommand}"
                            Margin="0,0,8,0"/>
                    <Button x:Name="CreateTopTracksPlaylistButton"
                            Content="＋ プレイリスト化"
                            Style="{StaticResource StatsSecondaryButtonStyle}"
                            Command="{Binding CreateTopTracksPlaylistCommand}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 2. メインコンテンツ領域（縦スクロール オールインワン構成） -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16">
            <StackPanel>
                <!-- エンプティ状態（選択期間内データ 0 件時） -->
                <Border x:Name="EmptyStatePanel"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24,36"
                        Margin="0,12,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource LocalBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="EmptyStateTitleText"
                                   Text="{Binding EmptyStateTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateMessageText"
                                   Text="{Binding EmptyStateMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="520"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 統計ダッシュボード本体 -->
                <StackPanel x:Name="StatsDashboardContent"
                            Visibility="{Binding HasData, Converter={StaticResource LocalBoolToVis}}">
                    <!-- 上段: KPI サマリカード 4 枚 -->
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <!-- KPI 1: 総再生回数 -->
                        <Border Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="総再生回数"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextForegroundBrush}"/>
                                <TextBlock x:Name="TotalPlayCountText"
                                           Text="{Binding TotalPlayCountDisplay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource NeonCyanBrush}"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DailyAveragePlayCountText"
                                           Text="{Binding DailyAveragePlayCountDisplay}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 2: 累計再生時間 -->
                        <Border Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="累計再生時間"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextForegroundBrush}"/>
                                <TextBlock x:Name="TotalListeningDurationText"
                                           Text="{Binding TotalListeningDurationDisplay}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextForegroundBrush}"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="完了再生ベース集計"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 3: 聴いたユニーク曲数 -->
                        <Border Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="聴いたユニーク曲数"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextForegroundBrush}"/>
                                <TextBlock x:Name="UniqueTrackCountText"
                                           Text="{Binding UniqueTrackCountDisplay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextForegroundBrush}"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UniqueLibraryBreakdownText"
                                           Text="{Binding UniqueLibraryBreakdownDisplay}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI 4: トップアーティスト -->
                        <Border Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="トップアーティスト"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextForegroundBrush}"/>
                                <TextBlock x:Name="TopArtistNameText"
                                           Text="{Binding TopArtistNameDisplay}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextForegroundBrush}"
                                           Margin="0,8,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TopArtistPlayCountText"
                                           Text="{Binding TopArtistPlayCountDisplay}"
                                           FontSize="11"
                                           Foreground="{DynamicResource NeonCyanBrush}"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 中段: 2 カラムランキング領域 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左カード: よく聴く曲 TOP 10 -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="よく聴く曲 TOP 10"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="クリックで再生 / 右クリックでメニュー"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <ItemsControl x:Name="TopTracksItemsControl"
                                              ItemsSource="{Binding TopTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LibraryStatsTrackItemViewModel}">
                                            <Button Command="{Binding DataContext.PlayTrackCommand, ElementName=LibraryStatsViewRoot}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StatsRankingRowButtonStyle}"
                                                    Tag="{Binding DataContext, ElementName=LibraryStatsViewRoot}"
                                                    Margin="0,0,0,4">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="今すぐ再生"
                                                                  Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="次に再生"
                                                                  Command="{Binding PlacementTarget.Tag.PlayNextTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="再生キューの最後に追加"
                                                                  Command="{Binding PlacementTarget.Tag.EnqueueTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="プレイリストに追加..."
                                                                  Command="{Binding PlacementTarget.Tag.AddTrackToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="アーティスト画面へ移動"
                                                                  Command="{Binding PlacementTarget.Tag.NavigateToArtistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue={x:Null}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- 順位 -->
                                                    <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                                               Text="{Binding Rank, StringFormat='#{0}'}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource NeonCyanBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <!-- アルバムアートサムネイル -->
                                                    <Border Grid.Column="1" Grid.RowSpan="2"
                                                            Width="30" Height="30"
                                                            CornerRadius="4"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource PanelBackgroundBrush}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left">
                                                        <Image services:AlbumArtLoader.SourcePath="{Binding FilePath}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>

                                                    <!-- 曲名・アーティスト -->
                                                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- 再生回数 -->
                                                    <TextBlock Grid.Column="3" Grid.Row="0"
                                                               Text="{Binding PlayCountDisplay}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextForegroundBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <!-- 再生回数ゲージバー -->
                                                    <ProgressBar Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1"
                                                                 Margin="4,4,0,0"
                                                                 Value="{Binding RatioPercent, Mode=OneWay}"
                                                                 Style="{StaticResource StatsGaugeProgressBarStyle}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 右カード: よく聴くアーティスト TOP 10 / アルバム TOP 10 切替 -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextForegroundBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="よく聴くアーティスト TOP 10"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlbumRankingSelected}" Value="True">
                                                        <Setter Property="Text" Value="よく聴くアルバム TOP 10"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="ArtistRankingTabButton"
                                                     Content="アーティスト"
                                                     GroupName="LibraryStatsRightRanking"
                                                     Style="{StaticResource StatsCompactToggleRadioButtonStyle}"
                                                     IsChecked="{Binding IsArtistRankingSelected, Mode=OneWay}"
                                                     Command="{Binding SelectArtistRankingCommand}"/>
                                        <RadioButton x:Name="AlbumRankingTabButton"
                                                     Content="アルバム"
                                                     GroupName="LibraryStatsRightRanking"
                                                     Style="{StaticResource StatsCompactToggleRadioButtonStyle}"
                                                     IsChecked="{Binding IsAlbumRankingSelected, Mode=OneWay}"
                                                     Command="{Binding SelectAlbumRankingCommand}"
                                                     Margin="0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- アーティスト TOP 10 -->
                                <ItemsControl x:Name="TopArtistsItemsControl"
                                              ItemsSource="{Binding TopArtists}"
                                              Visibility="{Binding IsArtistRankingSelected, Converter={StaticResource LocalBoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LibraryStatsArtistItemViewModel}">
                                            <Button Command="{Binding DataContext.NavigateToArtistCommand, ElementName=LibraryStatsViewRoot}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StatsRankingRowButtonStyle}"
                                                    Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                                               Text="{Binding Rank, StringFormat='#{0}'}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource NeonCyanBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <Border Grid.Column="1" Grid.RowSpan="2"
                                                            Width="30" Height="30"
                                                            CornerRadius="15"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource PanelBackgroundBrush}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left">
                                                        <Image services:AlbumArtLoader.SourcePath="{Binding RepresentativeFilePath}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding ArtistName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SubInfoDisplay}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Grid.Row="0"
                                                               Text="{Binding PlayCountDisplay}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextForegroundBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <ProgressBar Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1"
                                                                 Margin="4,4,0,0"
                                                                 Value="{Binding RatioPercent, Mode=OneWay}"
                                                                 Style="{StaticResource StatsGaugeProgressBarStyle}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- アルバム TOP 10 -->
                                <ItemsControl x:Name="TopAlbumsItemsControl"
                                              ItemsSource="{Binding TopAlbums}"
                                              Visibility="{Binding IsAlbumRankingSelected, Converter={StaticResource LocalBoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LibraryStatsAlbumItemViewModel}">
                                            <Button Command="{Binding DataContext.NavigateToAlbumCommand, ElementName=LibraryStatsViewRoot}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StatsRankingRowButtonStyle}"
                                                    Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                                               Text="{Binding Rank, StringFormat='#{0}'}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource NeonCyanBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <Border Grid.Column="1" Grid.RowSpan="2"
                                                            Width="30" Height="30"
                                                            CornerRadius="4"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource PanelBackgroundBrush}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left">
                                                        <Image services:AlbumArtLoader.SourcePath="{Binding RepresentativeFilePath}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding AlbumTitle}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SubInfoDisplay}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Grid.Row="0"
                                                               Text="{Binding PlayCountDisplay}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextForegroundBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <ProgressBar Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1"
                                                                 Margin="4,4,0,0"
                                                                 Value="{Binding RatioPercent, Mode=OneWay}"
                                                                 Style="{StaticResource StatsGaugeProgressBarStyle}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 下段: 2 カラムグラフ領域 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左グラフ: 日別・月別の再生推移バーチャート -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TrendChartTitleText"
                                               Grid.Column="0"
                                               Text="{Binding TrendChartTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="DailyTrendTabButton"
                                                     Content="日別"
                                                     GroupName="LibraryStatsTrendGranularity"
                                                     Style="{StaticResource StatsCompactToggleRadioButtonStyle}"
                                                     IsChecked="{Binding IsDailyTrendSelected, Mode=OneWay}"
                                                     Command="{Binding SelectDailyTrendCommand}"/>
                                        <RadioButton x:Name="MonthlyTrendTabButton"
                                                     Content="月別"
                                                     GroupName="LibraryStatsTrendGranularity"
                                                     Style="{StaticResource StatsCompactToggleRadioButtonStyle}"
                                                     IsChecked="{Binding IsMonthlyTrendSelected, Mode=OneWay}"
                                                     Command="{Binding SelectMonthlyTrendCommand}"
                                                     Margin="0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,12,10,8">
                                    <ItemsControl x:Name="TrendBarsItemsControl"
                                                  ItemsSource="{Binding TrendBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LibraryStatsChartBarViewModel}">
                                                <Grid ToolTip="{Binding ToolTipText}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="116"/>
                                                        <RowDefinition Height="16"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0"
                                                            Height="{Binding BarHeight}"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="2,2,0,0"
                                                            Margin="0.5,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource DarkNeonCyanBrush}"/>
                                                                <Setter Property="Opacity" Value="0.78"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPeak}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
                                                                        <Setter Property="Opacity" Value="1.0"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PlayCount}" Value="0">
                                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                                        <Setter Property="Opacity" Value="0.45"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Canvas Grid.Row="1" ClipToBounds="False">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource MutedTextForegroundBrush}"
                                                                   Canvas.Top="2"/>
                                                    </Canvas>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 右グラフ: リスニング傾向バーチャート（時間帯別 / 曜日別 + ピークインサイト） -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="リスニング傾向"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="HourlyHabitTabButton"
                                                     Content="時間帯別"
                                                     GroupName="LibraryStatsHabitAxis"
                                                     Style="{StaticResource StatsCompactToggleRadioButtonStyle}"
                                                     IsChecked="{Binding IsHourlyHabitSelected, Mode=OneWay}"
                                                     Command="{Binding SelectHourlyHabitCommand}"/>
                                        <RadioButton x:Name="DayOfWeekHabitTabButton"
                                                     Content="曜日別"
                                                     GroupName="LibraryStatsHabitAxis"
                                                     Style="{StaticResource StatsCompactToggleRadioButtonStyle}"
                                                     IsChecked="{Binding IsDayOfWeekHabitSelected, Mode=OneWay}"
                                                     Command="{Binding SelectDayOfWeekHabitCommand}"
                                                     Margin="0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,12,10,8">
                                    <ItemsControl x:Name="HabitBarsItemsControl"
                                                  ItemsSource="{Binding HabitBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LibraryStatsChartBarViewModel}">
                                                <Grid ToolTip="{Binding ToolTipText}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="116"/>
                                                        <RowDefinition Height="16"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0"
                                                            Height="{Binding BarHeight}"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="2,2,0,0"
                                                            Margin="0.5,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource DarkNeonCyanBrush}"/>
                                                                <Setter Property="Opacity" Value="0.72"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPeak}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
                                                                        <Setter Property="Opacity" Value="1.0"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PlayCount}" Value="0">
                                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                                        <Setter Property="Opacity" Value="0.45"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Canvas Grid.Row="1" ClipToBounds="False">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource MutedTextForegroundBrush}"
                                                                   Canvas.Top="2"/>
                                                    </Canvas>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- ピークインサイトバナー -->
                                <Border Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,7"
                                        Margin="0,10,0,0">
                                    <TextBlock x:Name="HabitPeakInsightText"
                                               Text="{Binding HabitPeakInsight}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NeonCyanBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
