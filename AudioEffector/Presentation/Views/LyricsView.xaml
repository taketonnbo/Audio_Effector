<UserControl x:Class="AudioEffector.Presentation.Views.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
             xmlns:vm="clr-namespace:AudioEffector.Presentation.ViewModels"
             mc:Ignorable="d"
             x:Name="LyricsViewRoot"
             d:DesignHeight="360" d:DesignWidth="420"
             d:DataContext="{d:DesignInstance vm:LyricsViewModel}">
    <UserControl.Resources>
        <!-- ヘッダーアイコンボタン（28x28px / SubtleButton） -->
        <Style x:Key="LyricsHeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.8"/>
                                <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PrimaryButton（LRC 自動生成導線） -->
        <Style x:Key="LyricsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InverseTextForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource DarkNeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SecondaryButton（再読み込み導線） -->
        <Style x:Key="LyricsSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SubtleButton（エラー時 LRC 生成補助導線） -->
        <Style x:Key="LyricsSubtleTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- フローティング「現在の再生行へ戻る」ピルボタン（DropShadowEffect 不使用） -->
        <Style x:Key="LyricsFloatingResumeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9999"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InverseTextForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌詞リスト用 ListBox テンプレート（仮想化維持＋上下中央寄せ余白ホスト） -->
        <ControlTemplate x:Key="LyricsListBoxTemplate" TargetType="ListBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ScrollViewer"
                              Focusable="False"
                              Padding="0"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter x:Name="PART_ItemsPresenter"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ScrollViewer>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <!-- 外側コンテナ（通常モード: PanelBackgroundBrush / コンパクトモード: WindowBackgroundBrush） -->
    <Border x:Name="OuterContainerBorder">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType={x:Type local:LyricsView}}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: パネルヘッダー（通常モードのみ表示 / コンパクトモードは Collapsed） -->
            <Border x:Name="LyricsHeaderBorder"
                    Grid.Row="0"
                    Height="36"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0,12,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType={x:Type local:LyricsView}}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左側: 音符アイコン + 見出し「歌詞」 + 状態バッジ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12,3V13.55C11.41,13.21 10.73,13 10,13A4,4 0 0,0 6,17A4,4 0 0,0 10,21A4,4 0 0,0 14,17V7H18V3H12Z"
                              Fill="{DynamicResource NeonCyanBrush}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="歌詞"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   VerticalAlignment="Center"/>

                        <!-- ソース・同期種別バッジ -->
                        <Border x:Name="SourceTypeBadge"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasSourceBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="SourceTypeBadgeText"
                                       Text="{Binding SourceBadgeText}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSynced}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextForegroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- 右側: アクションボタン群（再読み込み / LRC 自動生成 / 閉じる） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HeaderReloadButton"
                                Style="{StaticResource LyricsHeaderIconButtonStyle}"
                                Command="{Binding ReloadLyricsCommand}"
                                IsEnabled="{Binding CanReloadLyrics}"
                                Margin="0,0,4,0"
                                ToolTip="歌詞を再読み込み"
                                AutomationProperties.Name="歌詞を再読み込み">
                            <Path Data="M17.65,6.35A7.958,7.958 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="HeaderGenerateLrcButton"
                                Style="{StaticResource LyricsHeaderIconButtonStyle}"
                                Command="{Binding RequestGenerateLrcCommand}"
                                IsEnabled="{Binding CanGenerateLrc}"
                                Margin="0,0,4,0"
                                ToolTip="{Binding GenerateLrcToolTip}"
                                AutomationProperties.Name="LRC を自動生成・再生成">
                            <Path Data="M12,2L14.4,9.6L22,12L14.4,14.4L12,22L9.6,14.4L2,12L9.6,9.6L12,2Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="HeaderCloseButton"
                                Style="{StaticResource LyricsHeaderIconButtonStyle}"
                                Command="{Binding ClosePanelCommand}"
                                ToolTip="歌詞を閉じる"
                                AutomationProperties.Name="歌詞を閉じる">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: 歌詞コンテンツ領域 -->
            <Grid Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}">
                <!-- 1. 仮想化歌詞リスト（親 ScrollViewer 内包禁止・UI 仮想化 4 属性必須） -->
                <ListBox x:Name="LyricsListBox"
                         ItemsSource="{Binding Lines}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         SelectionMode="Single"
                         Template="{StaticResource LyricsListBoxTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="歌詞リスト"
                         PreviewMouseWheel="LyricsListBox_PreviewMouseWheel"
                         PreviewKeyDown="LyricsListBox_PreviewKeyDown"
                         SizeChanged="LyricsListBox_SizeChanged">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasLyrics}" Value="True"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                        <Condition Binding="{Binding HasError}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LyricLineItemViewModel}">
                            <Border x:Name="LyricRowBorder"
                                    CornerRadius="4"
                                    PreviewMouseLeftButtonDown="LyricRow_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="LyricRow_PreviewMouseLeftButtonUp"
                                    MouseLeave="LyricRow_MouseLeave">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="Margin" Value="16,4"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                        <Setter Property="ToolTip" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType={x:Type local:LyricsView}}}" Value="True">
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="Margin" Value="12,2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInstrumental}" Value="True">
                                                <Setter Property="Padding" Value="12,4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSeekable}" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="ToolTip" Value="{Binding TimestampDisplay}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSeekable}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左端 3px アクセント縦バー（常設して横ずれを防止） -->
                                    <Border x:Name="ActiveAccentBar"
                                            Grid.Column="0"
                                            Width="3"
                                            CornerRadius="2"
                                            Margin="0,2,0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- 歌詞本文または間奏ドット -->
                                    <TextBlock x:Name="LyricLineText"
                                               Grid.Column="1"
                                               Margin="10,0,0,0"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Text}"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextForegroundBrush}"/>
                                                <Style.Triggers>
                                                    <!-- コンパクトモード基準フォントサイズ -->
                                                    <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType={x:Type local:LyricsView}}}" Value="True">
                                                        <Setter Property="FontSize" Value="11"/>
                                                    </DataTrigger>
                                                    <!-- 非同期（プレーン）歌詞は全行均一コントラスト -->
                                                    <DataTrigger Binding="{Binding IsSynced}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                                    </DataTrigger>
                                                    <!-- 同期歌詞の前後近接行 -->
                                                    <DataTrigger Binding="{Binding IsNearActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextForegroundBrush}"/>
                                                    </DataTrigger>
                                                    <!-- シーク可能行ホバー時の視認性向上 -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSeekable}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, ElementName=LyricRowBorder}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                                    </MultiDataTrigger>
                                                    <!-- アクティブ（現在歌唱）行（通常モード） -->
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
                                                        <Setter Property="FontSize" Value="14"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <!-- アクティブ（現在歌唱）行（コンパクトモード） -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsActive}" Value="True"/>
                                                            <Condition Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType={x:Type local:LyricsView}}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </MultiDataTrigger>
                                                    <!-- 間奏・歌唱休止空行 -->
                                                    <DataTrigger Binding="{Binding IsInstrumental}" Value="True">
                                                        <Setter Property="Text" Value="• • •"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextForegroundBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 2. フローティング「現在の再生行へ戻る」ボタン（手動スクロール一時停止時のみ表示） -->
                <Button x:Name="ResumeAutoScrollButton"
                        Style="{StaticResource LyricsFloatingResumeButtonStyle}"
                        Command="{Binding ResumeAutoScrollCommand}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="10"
                        ToolTip="現在の再生行へ戻る"
                        AutomationProperties.Name="現在の再生行へ戻る"
                        Visibility="{Binding ShowResumeAutoScrollButton, Converter={StaticResource BoolToVis}}">
                    <Button.Margin>
                        <Thickness Left="0" Top="0" Right="0" Bottom="16"/>
                    </Button.Margin>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M11,4H13V16L18.5,10.5L19.92,11.92L12,19.84L4.08,11.92L5.5,10.5L11,16V4Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="11" Height="11" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="現在の再生行へ戻る" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 3. エンプティステート: 歌詞未検出 -->
                <Grid x:Name="LyricsNotFoundContainer"
                      Visibility="{Binding IsLyricsNotFoundState, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Path Data="M12,3V13.55C11.41,13.21 10.73,13 10,13A4,4 0 0,0 6,17A4,4 0 0,0 10,21A4,4 0 0,0 14,17V7H18V3H12Z"
