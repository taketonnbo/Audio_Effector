<UserControl x:Class="AudioEffector.Presentation.Views.DeviceSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
             xmlns:services="clr-namespace:AudioEffector.Presentation.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/> <!-- Device Explorer (Top) -->
            <RowDefinition Height="Auto"/> <!-- GridSplitter -->
            <RowDefinition Height="1*"/> <!-- PC Albums (Bottom) -->
            <RowDefinition Height="Auto"/> <!-- Transfer Button -->
        </Grid.RowDefinitions>

        <!-- Top: Device Explorer -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Combo Box -->
                <RowDefinition Height="Auto"/> <!-- Nav Bar -->
                <RowDefinition Height="*"/> <!-- Folder List -->
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Margin="0,0,0,10" IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                <TextBlock Text="CONNECTED DEVICE:" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="12" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding RemovableDrives}" SelectedItem="{Binding SelectedDevice}" 
                              Height="30"
                              Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="0" VerticalContentAlignment="Center" Padding="5,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextForegroundBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#303030"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>
                    
                    <Button Grid.Column="1" Content="⚙ Manage" Command="{Binding ShowDeviceManagerCommand}"
                            ToolTip="Open Device Storage Manager"
                            Height="30" Margin="5,0,0,0" Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="0" Padding="10,0"/>
                </Grid>
            </StackPanel>

            <!-- Navigation Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,5" IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content=".." Command="{Binding NavigateUpCommand}" Width="30" Height="25" Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding CurrentDevicePath}" Grid.Column="1" Foreground="{DynamicResource SecondaryTextForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="↻" Command="{Binding RefreshDirectoryCommand}" Width="30" Height="25" Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}" ToolTip="Refresh"/>
            </Grid>

            <!-- Folder List -->
            <ListBox Grid.Row="2" ItemsSource="{Binding DeviceDirectories}" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,5"
                     IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <Grid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.NavigateDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </Grid.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" Foreground="#FFD700" Margin="0,0,5,0" 
                                           Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="📄" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,0,5,0" 
                                           Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextForegroundBrush}" Padding="2"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#404040" Margin="0,5"/>

        <!-- Bottom: PC Albums Selection -->
        <Grid Grid.Row="2" Margin="0,5,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="SELECT ALBUMS / TRACKS TO TRANSFER:" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="12" Margin="0,0,0,5"/>
            
            <ListBox Grid.Row="1" ItemsSource="{Binding Albums}" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Expander Background="Transparent" BorderThickness="0" Margin="5">
                            <Expander.Header>
                                <Grid Width="250" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnDevice}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="IsChecked" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>

                                    <Grid Grid.Column="1" Width="40" Height="40" Margin="0,0,10,0">
                                        <Border CornerRadius="4" Background="{DynamicResource ControlBackgroundBrush}" ClipToBounds="True">
                                            <!-- Album Art -->
                                            <Image services:AlbumArtLoader.SourcePath="{Binding Tracks[0].FilePath}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Tracks}" Margin="20,5,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsOnDevice, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="IsChecked" Value="False"/>
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource SecondaryTextForegroundBrush}" FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsOnDevice, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Transfer Section -->
        <StackPanel Grid.Row="3">
            <Grid>
                <TextBlock Text="{Binding TransferProgress, StringFormat='Transferring: {0:0}%'}" Foreground="{DynamicResource TextForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="10"/>
            </Grid>
            
            <Button Command="{Binding TransferSelectedCommand}" Height="50" Background="#00FFFF" IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTransferring}" Value="True">
                                <Setter Property="Background" Value="#404040"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <TextBlock Text="TRANSFER SELECTED" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" Foreground="#000000"/>
                    <TextBlock Text="TRANSFERRING..." FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}" Foreground="#FFFFFF"/>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
