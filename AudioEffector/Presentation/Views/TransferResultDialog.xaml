<Window x:Class="AudioEffector.Presentation.Views.TransferResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AudioEffector.Presentation.Converters"
        Title="{Binding DialogTitle}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextForegroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <converters:BoolToVisConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock"
                   Grid.Row="0"
                   Text="{Binding HeaderText}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource NeonCyanBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- 結果サマリ件数カード -->
        <Border Grid.Row="1"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="成功" FontSize="11" Foreground="{DynamicResource SecondaryTextForegroundBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SuccessCountTextBlock" Text="{Binding SuccessCountText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource NeonCyanBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="スキップ（重複済み）" FontSize="11" Foreground="{DynamicResource SecondaryTextForegroundBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SkippedCountTextBlock" Text="{Binding SkippedCountText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="失敗" FontSize="11" Foreground="{DynamicResource SecondaryTextForegroundBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FailedCountTextBlock" Text="{Binding FailedCountText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFailedItems}" Value="True">
                                        <Setter Property="Foreground" Value="#E53E3E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 致命的エラー（デバイス切断等）メッセージ -->
        <Border x:Name="FatalErrorBorder"
                Grid.Row="2"
                Visibility="{Binding HasFatalError, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="#E53E3E"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12">
            <TextBlock x:Name="FatalErrorTextBlock"
                       Text="{Binding FatalErrorMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource TextForegroundBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 失敗曲一覧 -->
        <Border x:Name="FailedItemsBorder"
                Grid.Row="3"
                Visibility="{Binding HasFailedItems, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="失敗した楽曲一覧:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextForegroundBrush}"
                           Margin="0,0,0,6"/>

                <ListBox x:Name="FailedItemsListBox"
                         ItemsSource="{Binding FailedItems}"
                         MaxHeight="220"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ControlBackgroundHighlightBrush}"
                                    CornerRadius="3"
                                    Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding TrackTitle}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ErrorReason}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 閉じるボタン -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="CloseButton"
                    Content="閉じる"
                    IsDefault="True"
                    IsCancel="True"
                    Click="CloseButton_Click"
                    Padding="18,7"
                    Background="{DynamicResource NeonCyanBrush}"
                    Foreground="{DynamicResource InverseTextForegroundBrush}"
                    FontWeight="SemiBold"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
