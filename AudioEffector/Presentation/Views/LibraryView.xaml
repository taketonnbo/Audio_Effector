<UserControl x:Class="AudioEffector.Presentation.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
             xmlns:services="clr-namespace:AudioEffector.Presentation.AttachedProperties"
             xmlns:controls="clr-namespace:AudioEffector.Presentation.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Socket Tray Dedicated Slim ScrollViewer Style (#167) -->
        <Style x:Key="SocketTrayScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                   CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Width="3" MinWidth="3" MaxWidth="3"
                                       Margin="0,1,1,1"
                                       Background="Transparent"
                                       BorderThickness="0">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb Width="3" MinWidth="3" MaxWidth="3">
                                                    <Thumb.Template>
                                                        <ControlTemplate>
                                                            <Border Width="3" Background="{DynamicResource AlwaysNeonCyanBrush}"
                                                                    Opacity="0.7"
                                                                    CornerRadius="1.5"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Album Grid Card Expander Style (#166, #167) Non-destructive floating socket overlay -->
        <Style x:Key="AlbumGridExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid Background="{TemplateBinding Background}" ClipToBounds="False">
                            <!-- 通常のアルバムカード（ヘッダー: アート + タイトル + アーティスト） -->
                            <ContentPresenter x:Name="PART_Header"
                                              ContentSource="Header"
                                              RecognizesAccessKey="False"/>

                            <!-- 非破壊フロー用 Canvas（Height="0" で親グリッドのレイアウトサイズを拡張させない） -->
                            <Canvas ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Top" Width="140" Height="0">
                                <!-- ソケット風収録曲オーバーレイコンテナ (#167 B案: グラスモフィズム調 5曲ジャスト表示) -->
                                <Border x:Name="SocketTray"
                                        Canvas.Top="140"
                                        Canvas.Left="0"
                                        Width="140"
                                        Height="140"
                                        CornerRadius="8"
                                        Background="#E60D1522"
                                        BorderBrush="{DynamicResource AlwaysNeonCyanBrush}"
                                        BorderThickness="1"
                                        Visibility="Collapsed"
                                        Opacity="0"
                                        ClipToBounds="True"
                                        Panel.ZIndex="100">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource AlwaysNeonCyanColor}" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="SocketTrayTranslate" Y="-30"/>
                                    </Border.RenderTransform>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- ヘッダー: 曲数表示（B案・TrackListテキスト不要） -->
                                        <Border Grid.Row="0" Height="24" Margin="6,2,6,2" Padding="0" BorderThickness="0,0,0,1" BorderBrush="#3000FFFF">
                                            <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} Tracks'}"
                                                       Foreground="{DynamicResource AlwaysNeonCyanBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.85"/>
                                        </Border>

                                        <!-- 収録曲リストコンテナ (ぴったり5曲分: 22px × 5 = 110px) -->
                                        <ScrollViewer Grid.Row="1"
                                                      Height="110"
                                                      Style="{StaticResource SocketTrayScrollViewerStyle}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Padding="2,0,2,0">
                                            <ContentPresenter x:Name="PART_Content" ContentSource="Content"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="SocketTray" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SocketTrayTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             From="-30" To="0"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.25" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SocketTray"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SocketTrayTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-30"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SocketTray"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Album Tracks Toggle Button Style (#166) -->
        <Style x:Key="AlbumTracksToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Path x:Name="ChevronIcon"
                                  Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                  Fill="{DynamicResource TextForegroundBrush}"
                                  Stretch="Uniform"
                                  Width="10" Height="10"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#B3000000"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AlwaysNeonCyanBrush}"/>
                                <Setter TargetName="ChevronIcon" Property="Fill" Value="{DynamicResource AlwaysNeonCyanBrush}"/>
                                <Setter TargetName="ToggleBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource AlwaysNeonCyanColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="180" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Album Info Button Style (#168) Three-dots icon matching AlbumTracksToggleButtonStyle -->
        <Style x:Key="AlbumInfoButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InfoBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <!-- 三点リーダーアイコン（通常時: 白 / ホバー時: 水色ハイライト） -->
                            <Path x:Name="DotsIcon"
                                  Data="M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z"
                                  Fill="{DynamicResource TextForegroundBrush}"
                                  Stretch="Uniform"
                                  Width="11" Height="11"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ボタンホバー時: 左下収録曲リストボタンと同調した水色ハイライト＆ネオングロー -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InfoBorder" Property="Background" Value="#B3000000"/>
                                <Setter TargetName="InfoBorder" Property="BorderBrush" Value="{DynamicResource AlwaysNeonCyanBrush}"/>
                                <Setter TargetName="DotsIcon" Property="Fill" Value="{DynamicResource AlwaysNeonCyanBrush}"/>
                                <Setter TargetName="InfoBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource AlwaysNeonCyanColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- アルバムアートホバー時にフェードイン表示 (通常時は非表示 Opacity=0) -->
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=AlbumArtBorder}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" 
                                  Height="25" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                        
                        <Button Grid.Column="1" Command="{Binding ToggleSortDirectionCommand}" Width="30" Height="25" ToolTip="Toggle Sort Direction" Margin="0,0,5,0">
                            <Path Fill="White" Stretch="Uniform" Width="10" Height="10">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M7,10L12,15L17,10H7Z"/> 
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAscending}" Value="True">
                                                <Setter Property="Data" Value="M7,14L12,9L17,14H7Z"/> 
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding ToggleViewCommand}" Width="30" Height="25" ToolTip="Toggle View">
                            <Path Data="M4,4H8V8H4V4M10,4H14V8H10V4M16,4H20V8H16V4M4,10H8V14H4V10M10,10H14V14H10V10M16,10H20V14H16V10M4,16H8V20H4V16M10,16H14V20H10V16M16,16H20V20H16V16" 
                                  Fill="White" Stretch="Uniform" Margin="5" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ToggleViewCommand}" Width="30" Height="25" ToolTip="Toggle View" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                             <Path Data="M4,5H20V19H4V5M4,5H20V7H4V5M4,9H20V11H4V9M4,13H20V15H4V13M4,17H20V19H4V17" 
                                   Fill="White" Stretch="Uniform" Margin="5"/>
                        </Button>
                    </Grid>
            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Albums}" 
                         Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Expander Background="Transparent" BorderThickness="0" Margin="5" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid x:Name="AlbumListItemGrid" HorizontalAlignment="Stretch" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="再生" Command="{Binding PlacementTarget.Tag.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.Playlist.ShowAddAlbumToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding DataContext.IsSelectionMode, ElementName=MainWindowRoot}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOnDevice}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="IsChecked" Value="False"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.DeviceBrowser.IsTransferring, ElementName=MainWindowRoot}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>

                                        <Grid Grid.Column="1" Width="40" Height="40" Margin="0,0,10,0">
                                            <Border CornerRadius="2" Background="{DynamicResource ControlBackgroundBrush}" ClipToBounds="True">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,40,40" RadiusX="2" RadiusY="2"/>
                                                </Border.Clip>
                                                <!-- Use AlbumArtLoader attached property -->
                                                <Image services:AlbumArtLoader.SourcePath="{Binding Tracks[0].FilePath}" Stretch="UniformToFill"/>
                                            </Border>
                                            <!-- Play Overlay -->
                                            <Button Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid Background="#80000000">
                                                    <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{DynamicResource AlwaysNeonCyanBrush}" Stretch="Uniform" Width="20" Height="20">
                                                        <Path.Effect>
                                                            <DropShadowEffect Color="{DynamicResource AlwaysNeonCyanColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                                        </Path.Effect>
                                                    </Path>
                                                    <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Stroke="{DynamicResource AlwaysNeonCyanBrush}" StrokeThickness="2" Stretch="Uniform" Width="20" Height="20">
                                                        <Path.Effect>
                                                            <DropShadowEffect Color="{DynamicResource AlwaysNeonCyanColor}" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                                                        </Path.Effect>
                                                    </Path>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <controls:MarqueeTextBlock Text="{Binding Title}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="14" IsHovered="{Binding IsMouseOver, ElementName=AlbumListItemGrid}"/>
                                            <controls:MarqueeTextBlock Text="{Binding Artist}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" IsHovered="{Binding IsMouseOver, ElementName=AlbumListItemGrid}"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Tracks}" Margin="20,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    HorizontalContentAlignment="Left" Margin="0,2" Background="Transparent" BorderThickness="0">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Header" Value="再生" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                                                <Condition Binding="{Binding PlacementTarget.Tag.IsPlaying, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Header" Value="停止" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Header" Value="お気に入りに追加" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Header" Value="お気に入りから解除" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.Playlist.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="プロパティ" Command="{Binding PlacementTarget.Tag.ShowTrackPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="ファイルの場所を開く" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                              Visibility="{Binding DataContext.IsSelectionMode, ElementName=MainWindowRoot, Converter={StaticResource BoolToVis}}"
                                                              IsEnabled="{Binding DataContext.DeviceBrowser.IsTransferring, ElementName=MainWindowRoot, Converter={StaticResource InvertBool}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource SecondaryTextForegroundBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <Path Grid.Column="2" Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" 
                                                          Fill="#FF4081" Width="10" Height="10" Stretch="Uniform" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" Margin="0,0,5,0"/>
                                                    <Button Grid.Column="3" Content="+" ToolTip="Add to Playlist" 
                                                            Command="{Binding DataContext.Playlist.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="18" Height="18" FontSize="14" FontWeight="Bold"
                                                            Background="Transparent" Foreground="{StaticResource NeonCyanBrush}" BorderThickness="0" Padding="0" Margin="0"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer x:Name="GridScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}" PreviewMouseDown="GridScrollViewer_PreviewMouseDown">
                    <ItemsControl ItemsSource="{Binding Albums}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Panel.ZIndex" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTracksExpanded}" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="100"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Style="{StaticResource AlbumGridExpanderStyle}" IsExpanded="{Binding IsTracksExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid x:Name="AlbumCardGrid" Width="140" Height="170" ClipToBounds="False" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="再生" Command="{Binding PlacementTarget.Tag.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.Playlist.ShowAddAlbumToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="140"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="AlbumArtBorder" Grid.Row="0" CornerRadius="3" Background="{DynamicResource ControlBackgroundBrush}" Margin="5" ClipToBounds="True">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,130,130" RadiusX="3" RadiusY="3"/>
                                                </Border.Clip>
                                                <Grid>
                                                    <!-- Use AlbumArtLoader attached property -->
                                                    <Image services:AlbumArtLoader.SourcePath="{Binding Tracks[0].FilePath}" Stretch="UniformToFill"/>
                                                    
                                                    <!-- Play Overlay -->
                                                    <Button Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                            Panel.ZIndex="5">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Grid Background="Transparent">
                                                                                <ContentPresenter/>
                                                                            </Grid>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=AlbumArtBorder}" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid Background="#80000000">
                                                            <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="Transparent" Stroke="{DynamicResource AlwaysNeonCyanBrush}" StrokeThickness="3" Stretch="Uniform" Width="50" Height="50">
                                                                <Path.Effect>
                                                                    <DropShadowEffect Color="{DynamicResource AlwaysNeonCyanColor}" BlurRadius="15" ShadowDepth="0" Opacity="1"/>
                                                                </Path.Effect>
                                                            </Path>
                                                            <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{DynamicResource AlwaysNeonCyanBrush}" Opacity="0.2" Stretch="Uniform" Width="50" Height="50"/>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Album Tracks Toggle Button (#166, #167) -->
                                                    <ToggleButton x:Name="AlbumTracksToggleButton"
                                                                  Style="{StaticResource AlbumTracksToggleButtonStyle}"
                                                                  Command="{Binding DataContext.ToggleAlbumTracksCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"
                                                                  IsChecked="{Binding IsTracksExpanded, Mode=OneWay}"
                                                                  VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                                  Margin="4,0,0,4"
                                                                  Panel.ZIndex="15"
                                                                  ToolTip="収録曲を表示/非表示"/>

                                                    <!-- Album Info Button (#168) Hover-only Neon Cyan style -->
                                                    <Button x:Name="AlbumInfoButton"
                                                            Style="{StaticResource AlbumInfoButtonStyle}"
                                                            Command="{Binding DataContext.ShowAlbumInfoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                            Margin="0,0,4,4"
                                                            Panel.ZIndex="15"
                                                            ToolTip="アルバム詳細情報を表示"/>
                                                    
                                                    <!-- Album Selection CheckBox -->
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0"
                                                              Panel.ZIndex="15">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsOnDevice}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="IsChecked" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataContext.DeviceBrowser.IsTransferring, ElementName=MainWindowRoot}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                        <CheckBox.LayoutTransform>
                                                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                                        </CheckBox.LayoutTransform>
                                                    </CheckBox>
                                                </Grid>
                                            </Border>
                                            <controls:MarqueeTextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="12" HorizontalContentAlignment="Center" Margin="5,2,5,0" IsHovered="{Binding IsMouseOver, ElementName=AlbumCardGrid}"/>
                                            <controls:MarqueeTextBlock Grid.Row="2" Text="{Binding Artist}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="10" HorizontalContentAlignment="Center" Margin="5,0,5,5" IsHovered="{Binding IsMouseOver, ElementName=AlbumCardGrid}"/>
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Tracks}" AlternationCount="999" Margin="2,0,2,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="SocketTrackRowRoot"
                                                      Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}">
                                                    <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Height="22"
                                                            HorizontalContentAlignment="Stretch" Margin="0" Background="Transparent" BorderThickness="0" Padding="4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="TrackRowBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="TrackRowBorder" Property="Background" Value="#2500FFFF"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Header" Value="再生" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                                                        <Condition Binding="{Binding PlacementTarget.Tag.IsPlaying, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Header" Value="停止" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                                <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                                <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                                <Separator/>
                                                                <MenuItem Header="お気に入りに追加/解除" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                                <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.Playlist.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                                <Separator/>
                                                                <MenuItem Header="プロパティ" Command="{Binding PlacementTarget.Tag.ShowTrackPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                                <MenuItem Header="ファイルの場所を開く" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                                <Separator/>
                                                                <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>

                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                      Visibility="{Binding DataContext.IsSelectionMode, ElementName=MainWindowRoot, Converter={StaticResource BoolToVis}}"
                                                                      IsEnabled="{Binding DataContext.DeviceBrowser.IsTransferring, ElementName=MainWindowRoot, Converter={StaticResource InvertBool}}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Tag, ElementName=SocketTrackRowRoot, Converter={StaticResource IndexConverter}, StringFormat='{}{0:00}.'}"
                                                                       Foreground="{DynamicResource AlwaysNeonCyanBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Left"
                                                                       Opacity="0.85"/>
                                                            <controls:MarqueeTextBlock Grid.Column="2"
                                                                                       Text="{Binding Title}"
                                                                                       Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                                                                       FontSize="11"
                                                                                       VerticalAlignment="Center"
                                                                                       IsHovered="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                        </Grid>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
    </Grid>
</UserControl>
