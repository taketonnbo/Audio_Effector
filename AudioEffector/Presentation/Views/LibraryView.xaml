<UserControl x:Class="AudioEffector.Presentation.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
             xmlns:services="clr-namespace:AudioEffector.Presentation.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" 
                                  Height="25" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                        
                        <Button Grid.Column="1" Command="{Binding ToggleSortDirectionCommand}" Width="30" Height="25" ToolTip="Toggle Sort Direction" Margin="0,0,5,0">
                            <Path Fill="White" Stretch="Uniform" Width="10" Height="10">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M7,10L12,15L17,10H7Z"/> 
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAscending}" Value="True">
                                                <Setter Property="Data" Value="M7,14L12,9L17,14H7Z"/> 
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding ToggleViewCommand}" Width="30" Height="25" ToolTip="Toggle View">
                            <Path Data="M4,4H8V8H4V4M10,4H14V8H10V4M16,4H20V8H16V4M4,10H8V14H4V10M10,10H14V14H10V10M16,10H20V14H16V10M4,16H8V20H4V16M10,16H14V20H10V16M16,16H20V20H16V16" 
                                  Fill="White" Stretch="Uniform" Margin="5" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ToggleViewCommand}" Width="30" Height="25" ToolTip="Toggle View" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                             <Path Data="M4,5H20V19H4V5M4,5H20V7H4V5M4,9H20V11H4V9M4,13H20V15H4V13M4,17H20V19H4V17" 
                                   Fill="White" Stretch="Uniform" Margin="5"/>
                        </Button>
                    </Grid>
            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Albums}" 
                         Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Expander Background="Transparent" BorderThickness="0" Margin="5" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid HorizontalAlignment="Stretch" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="再生" Command="{Binding PlacementTarget.Tag.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.ShowAddAlbumToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding DataContext.IsSelectionMode, ElementName=MainWindowRoot}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOnDevice}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="IsChecked" Value="False"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsTransferring, ElementName=MainWindowRoot}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>

                                        <Grid Grid.Column="1" Width="40" Height="40" Margin="0,0,10,0">
                                            <Border CornerRadius="4" Background="{DynamicResource ControlBackgroundBrush}" ClipToBounds="True">
                                                <!-- Use AlbumArtLoader attached property -->
                                                <Image services:AlbumArtLoader.SourcePath="{Binding Tracks[0].FilePath}" Stretch="UniformToFill"/>
                                            </Border>
                                            <!-- Play Overlay -->
                                            <Button Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid Background="#80000000">
                                                    <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{StaticResource NeonCyanBrush}" Stretch="Uniform" Width="20" Height="20">
                                                        <Path.Effect>
                                                            <DropShadowEffect Color="{StaticResource NeonCyanColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                                        </Path.Effect>
                                                    </Path>
                                                    <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Stroke="{StaticResource NeonCyanBrush}" StrokeThickness="2" Stretch="Uniform" Width="20" Height="20">
                                                        <Path.Effect>
                                                            <DropShadowEffect Color="{StaticResource NeonCyanColor}" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                                                        </Path.Effect>
                                                    </Path>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Tracks}" Margin="20,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    HorizontalContentAlignment="Left" Margin="0,2" Background="Transparent" BorderThickness="0">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Header" Value="再生" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                                                <Condition Binding="{Binding PlacementTarget.Tag.IsPlaying, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Header" Value="停止" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Header" Value="お気に入りに追加" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Header" Value="お気に入りから解除" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="プロパティ" Command="{Binding PlacementTarget.Tag.ShowTrackPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="ファイルの場所を開く" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                              Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                                              IsEnabled="{Binding DataContext.IsTransferring, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertBool}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource SecondaryTextForegroundBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <Path Grid.Column="2" Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" 
                                                          Fill="#FF4081" Width="10" Height="10" Stretch="Uniform" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" Margin="0,0,5,0"/>
                                                    <Button Grid.Column="3" Content="+" ToolTip="Add to Playlist" 
                                                            Command="{Binding DataContext.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Width="18" Height="18" FontSize="14" FontWeight="Bold"
                                                            Background="Transparent" Foreground="{StaticResource NeonCyanBrush}" BorderThickness="0" Padding="0" Margin="0"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Albums}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Background="Transparent" BorderThickness="0" Margin="5" Width="160" Padding="0">
                                <Expander.Header>
                                        <Grid Width="140" Height="170" ClipToBounds="False" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="再生" Command="{Binding PlacementTarget.Tag.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.ShowAddAlbumToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="140"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8" Background="{DynamicResource ControlBackgroundBrush}" Margin="5" ClipToBounds="True">
                                                <Grid>
                                                    <!-- Use AlbumArtLoader attached property -->
                                                    <Image services:AlbumArtLoader.SourcePath="{Binding Tracks[0].FilePath}" Stretch="UniformToFill"/>
                                                    
                                                    <!-- Play Overlay -->
                                                    <Button Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Grid Background="Transparent">
                                                                                <ContentPresenter/>
                                                                            </Grid>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid Background="#60000000">
                                                            <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="Transparent" Stroke="{StaticResource NeonCyanBrush}" StrokeThickness="3" Stretch="Uniform" Width="50" Height="50">
                                                                <Path.Effect>
                                                                    <DropShadowEffect Color="{StaticResource NeonCyanColor}" BlurRadius="15" ShadowDepth="0" Opacity="1"/>
                                                                </Path.Effect>
                                                            </Path>
                                                            <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{StaticResource NeonCyanBrush}" Opacity="0.2" Stretch="Uniform" Width="50" Height="50"/>
                                                        </Grid>
                                                    </Button>
                                                    
                                                    <!-- Album Selection CheckBox -->
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0"
                                                              Panel.ZIndex="10">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsOnDevice}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="IsChecked" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataContext.IsTransferring, ElementName=MainWindowRoot}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                        <CheckBox.LayoutTransform>
                                                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                                        </CheckBox.LayoutTransform>
                                                    </CheckBox>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="5,2,5,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding Artist}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="5,0,5,5"/>
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Tracks}" Margin="5,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Left" Margin="0,2" Background="Transparent" BorderThickness="0">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                                <MenuItem.Style>
                                                                    <Style TargetType="MenuItem">
                                                                        <Setter Property="Header" Value="再生" />
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                                                    <Condition Binding="{Binding PlacementTarget.Tag.IsPlaying, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Header" Value="停止" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <Separator/>
                                                            <MenuItem Header="お気に入りに追加/解除" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <Separator/>
                                                            <MenuItem Header="プロパティ" Command="{Binding PlacementTarget.Tag.ShowTrackPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="ファイルの場所を開く" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <Separator/>
                                                            <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                     <!-- Context menu removed -->

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,5,0">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsSelectionMode, ElementName=MainWindowRoot}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DataContext.IsTransferring, ElementName=MainWindowRoot}" Value="True">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource SecondaryTextForegroundBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="2" Content="+" ToolTip="Add to Playlist" 
                                                                Command="{Binding DataContext.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Width="18" Height="18" FontSize="14" FontWeight="Bold"
                                                                Background="Transparent" Foreground="{StaticResource NeonCyanBrush}" BorderThickness="0" Padding="0" Margin="0"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
    </Grid>
</UserControl>