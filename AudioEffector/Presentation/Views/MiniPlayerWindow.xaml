<Window x:Class="AudioEffector.Presentation.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:AudioEffector.Presentation.Controls"
        mc:Ignorable="d"
        Title="Mini Player" Height="100" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style TargetType="Button" x:Key="IconButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="QueueActionButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SquareOverlayIconButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Mini Player Header Area (Standard / Square Switchable) -->
            <Grid x:Name="MiniPlayerHeaderHost" Grid.Row="0" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding CurrentTrack}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="お気に入りに追加" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTrack.IsFavorite}" Value="True">
                                            <Setter Property="Header" Value="お気に入りから解除" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="プレイリストに追加..." Command="{Binding Playlist.ShowAddToPlaylistDialogCommand}" CommandParameter="{Binding CurrentTrack}" />
                        <Separator />
                        <MenuItem Header="プロパティ表示" Command="{Binding ShowTrackPropertiesCommand}" CommandParameter="{Binding CurrentTrack}" />
                        <MenuItem Header="ファイルの場所を開く" Command="{Binding OpenFileLocationCommand}" CommandParameter="{Binding CurrentTrack}" />
                        <Separator />
                        <MenuItem Command="{Binding ToggleMiniPlayerQueueCommand}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="再生キューを表示" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMiniPlayerQueueOpen}" Value="True">
                                            <Setter Property="Header" Value="再生キューを閉じる" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="削除" Command="{Binding DeleteTrackCommand}" CommandParameter="{Binding CurrentTrack}" Foreground="#FF4444" />
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- Standard Horizontal Layout (350x100) -->
                <Grid x:Name="StandardLayoutGrid" Height="98" Background="Transparent">
                    <Grid Margin="10" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Art & Track Info (Hover Linked) -->
                        <Grid Grid.Column="0" Grid.ColumnSpan="2" x:Name="MiniPlayerInfoArea" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Album Art -->
                            <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ControlBackgroundHighlightBrush}">
                                <Image Source="{Binding CurrentTrack.AlbumArt}" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Track Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                                <controls:MarqueeTextBlock Text="{Binding CurrentTrack.Title, FallbackValue='No Track'}"
                                                           Foreground="{DynamicResource TextForegroundBrush}" FontWeight="Bold" FontSize="14"
                                                           IsHovered="{Binding IsMouseOver, ElementName=MiniPlayerInfoArea}"/>
                                <controls:MarqueeTextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Unknown Artist'}"
                                                           Foreground="{DynamicResource SecondaryTextForegroundBrush}" FontSize="12" Margin="0,4,0,0"
                                                           IsHovered="{Binding IsMouseOver, ElementName=MiniPlayerInfoArea}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding PreviousCommand}" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="1">
                                <TextBlock Text="⏮" Foreground="{DynamicResource TextForegroundBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding TogglePlayPauseCommand}" Style="{StaticResource IconButtonStyle}" Width="34" Height="34" Margin="1">
                                <TextBlock Text="⏯" Foreground="{DynamicResource NeonCyanBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding NextCommand}" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="1">
                                <TextBlock Text="⏭" Foreground="{DynamicResource TextForegroundBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Queue Toggle Button -->
                            <Button x:Name="ToggleQueueButton"
                                    Command="{Binding ToggleMiniPlayerQueueCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="26" Height="26" Margin="4,0,0,0">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="再生キューを表示"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMiniPlayerQueueOpen}" Value="True">
                                                            <Setter Property="Text" Value="再生キューを閉じる"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H15V18H3V16Z"
                                      Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMiniPlayerQueueOpen}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource NeonCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>

                            <!-- Restore Button -->
                            <Button Click="RestoreButton_Click" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Margin="2,0,0,0" ToolTip="元に戻す">
                                <TextBlock Text="⤢" Foreground="{DynamicResource TextForegroundBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Square Album Art Layout (220x220) -->
                <Grid x:Name="SquareLayoutGrid"
                      Width="218"
                      Height="218"
                      Visibility="Collapsed"
                      Background="{DynamicResource WindowBackgroundBrush}"
                      ClipToBounds="True">

                    <!-- Circular Window with Rotating Album Art (Rotate ON) -->
                    <Grid x:Name="SquareCircularArtContainer" Visibility="Visible">
                        <Border Width="184"
                                Height="184"
                                CornerRadius="92"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                Background="{DynamicResource ControlBackgroundHighlightBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.Clip>
                                    <EllipseGeometry Center="90,90" RadiusX="90" RadiusY="90"/>
                                </Grid.Clip>
                                <Grid x:Name="SquareRotatingArtSurface" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="SquareAlbumArtRotateTransform" Angle="0"/>
                                    </Grid.RenderTransform>
                                    <TextBlock Text="♫"
                                               FontSize="54"
                                               Foreground="{DynamicResource MutedTextForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Image Source="{Binding CurrentTrack.AlbumArt}" Stretch="UniformToFill"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Full-Bleed Static Album Art (Rotate OFF) -->
                    <Grid x:Name="SquareStaticAlbumArtContainer"
                          Visibility="Collapsed"
                          Background="{DynamicResource ControlBackgroundHighlightBrush}">
                        <TextBlock Text="♫"
                                   FontSize="58"
                                   Foreground="{DynamicResource MutedTextForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image Source="{Binding CurrentTrack.AlbumArt}" Stretch="UniformToFill"/>
                    </Grid>

                    <!-- Non-Rotating Overlay Controls (Visible on Hover / Keyboard Focus) -->
                    <Grid x:Name="SquareOverlayControlsLayer" Panel.ZIndex="2" Background="Transparent">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=SquareLayoutGrid}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SquareLayoutGrid}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- Restore Button (Top-Right) -->
                        <Button x:Name="SquareRestoreButton"
                                Click="RestoreButton_Click"
                                Style="{StaticResource SquareOverlayIconButtonStyle}"
                                Background="#99161920"
                                Width="26"
                                Height="26"
                                Margin="0,8,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                ToolTip="元に戻す">
                            <TextBlock Text="⤢"
                                       Foreground="#F0F4F8"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Playback Controls Capsule (Centered Inside Circular Window) -->
                        <Border x:Name="SquarePlaybackControlsOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#B3161920"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="6,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SquarePreviousButton"
                                        Command="{Binding PreviousCommand}"
                                        Style="{StaticResource SquareOverlayIconButtonStyle}"
                                        Width="30" Height="30"
                                        ToolTip="前の曲">
                                    <TextBlock Text="⏮" Foreground="#F0F4F8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="SquarePlayPauseButton"
                                        Command="{Binding TogglePlayPauseCommand}"
                                        Style="{StaticResource SquareOverlayIconButtonStyle}"
                                        Width="38" Height="38"
                                        Margin="2,0"
                                        ToolTip="再生 / 一時停止">
                                    <TextBlock Foreground="{DynamicResource AlwaysNeonCyanBrush}"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▶"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Text" Value="⏸"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button x:Name="SquareNextButton"
                                        Command="{Binding NextCommand}"
                                        Style="{StaticResource SquareOverlayIconButtonStyle}"
                                        Width="30" Height="30"
                                        ToolTip="次の曲">
                                    <TextBlock Text="⏭" Foreground="#F0F4F8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Integrated Bottom-Docked Play Queue Drawer -->
            <Border x:Name="QueueDrawerContainer"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Queue Drawer Header -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H15V18H3V16Z"
                                      Fill="{DynamicResource NeonCyanBrush}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="再生キュー"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource NeonCyanBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PlayQueue.Count, StringFormat=' ({0})'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextForegroundBrush}"
                                           VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ClearQueueCommand}"
                                        Style="{StaticResource QueueActionButtonStyle}"
                                        Width="22" Height="22" Margin="0,0,2,0"
                                        ToolTip="再生キューをすべてクリア">
                                    <Path Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"
                                          Fill="{DynamicResource MutedTextForegroundBrush}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                                <Button Command="{Binding CloseMiniPlayerQueueCommand}"
                                        Style="{StaticResource QueueActionButtonStyle}"
                                        Width="22" Height="22"
                                        ToolTip="再生キューを閉じる">
                                    <Path Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                                          Fill="{DynamicResource TextForegroundBrush}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Queue List Content -->
                    <Grid Grid.Row="1">
                        <!-- Empty State Message -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayQueue.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="再生キューは空です"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextForegroundBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- UI Virtualized Queue ListBox -->
                        <ListBox x:Name="MiniQueueListBox"
                                 ItemsSource="{Binding PlayQueue}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayQueue.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="QueueItemBorder"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Margin="0,1"
                                            Padding="4,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Play Button -->
                                            <Button Grid.Column="0"
                                                    Command="{Binding DataContext.PlayFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource QueueActionButtonStyle}"
                                                    Width="24" Height="24" Margin="0,0,6,0"
                                                    ToolTip="再生">
                                                <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                                      Fill="{DynamicResource NeonCyanBrush}"
                                                      Width="10" Height="10" Stretch="Uniform"/>
                                            </Button>

                                            <!-- Track Title & Artist -->
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.PlayFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" VerticalAlignment="Stretch">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextForegroundBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Artist}"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Remove Button -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource QueueActionButtonStyle}"
                                                    Width="22" Height="22" Margin="4,0,0,0"
                                                    ToolTip="キューから削除">
                                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Fill="{DynamicResource MutedTextForegroundBrush}"
                                                      Width="9" Height="9" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True" SourceName="QueueItemBorder">
                                            <Setter TargetName="QueueItemBorder" Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
