<Window x:Class="AudioEffector.Presentation.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:controls="clr-namespace:AudioEffector.Presentation.Controls"
        mc:Ignorable="d" 
        Title="Mini Player" Height="100" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style TargetType="Button" x:Key="IconButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="10" Background="Transparent">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding CurrentTrack}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="お気に入りに追加" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTrack.IsFavorite}" Value="True">
                                        <Setter Property="Header" Value="お気に入りから解除" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="プレイリストに追加..." Command="{Binding Playlist.ShowAddToPlaylistDialogCommand}" CommandParameter="{Binding CurrentTrack}" />
                    <Separator />
                    <MenuItem Header="プロパティ表示" Command="{Binding ShowTrackPropertiesCommand}" CommandParameter="{Binding CurrentTrack}" />
                    <MenuItem Header="ファイルの場所を開く" Command="{Binding OpenFileLocationCommand}" CommandParameter="{Binding CurrentTrack}" />
                    <Separator />
                    <MenuItem Header="再生リストの表示" Command="{Binding ShowQueueDialogCommand}" />
                    <Separator />
                    <MenuItem Header="削除" Command="{Binding DeleteTrackCommand}" CommandParameter="{Binding CurrentTrack}" Foreground="#FF4444" />
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Album Art -->
            <Border CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ControlBackgroundHighlightBrush}">
                <Image Source="{Binding CurrentTrack.AlbumArt}" Stretch="UniformToFill"/>
            </Border>

            <!-- Track Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <controls:MarqueeTextBlock Text="{Binding CurrentTrack.Title, FallbackValue='No Track'}" 
                                           Foreground="{DynamicResource TextForegroundBrush}" FontWeight="Bold" FontSize="14"/>
                <controls:MarqueeTextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Unknown Artist'}" 
                                           Foreground="{DynamicResource SecondaryTextForegroundBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding PreviousCommand}" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Margin="2">
                    <TextBlock Text="⏮" Foreground="{DynamicResource TextForegroundBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding TogglePlayPauseCommand}" Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Margin="2">
                    <TextBlock Text="⏯" Foreground="{DynamicResource NeonCyanBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding NextCommand}" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Margin="2">
                    <TextBlock Text="⏭" Foreground="{DynamicResource TextForegroundBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                
                <!-- Restore Button -->
                <Button Click="RestoreButton_Click" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Margin="10,0,0,0" ToolTip="元に戻す">
                    <TextBlock Text="⤢" Foreground="{DynamicResource TextForegroundBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
