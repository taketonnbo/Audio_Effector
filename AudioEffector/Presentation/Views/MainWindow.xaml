<Window x:Class="AudioEffector.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
        xmlns:vm="clr-namespace:AudioEffector.Presentation.ViewModels"
        xmlns:views="clr-namespace:AudioEffector.Presentation.Views"
        xmlns:controls="clr-namespace:AudioEffector.Presentation.Controls"
        mc:Ignorable="d"
        Title="Audio Effector" Height="650" Width="1000"
        Icon="pack://application:,,,/Audio_Effector_icon_1.0.1.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        x:Name="MainWindowRoot"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Window Root Border Style (Handles Maximized Margin and Window Border) -->
        <Style x:Key="MainWindowRootBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource TitleBarBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Title Bar Base Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Minimize Button Style -->
        <Style x:Key="TitleBarMinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="ToolTip" Value="最小化"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Line X1="0" Y1="0" X2="10" Y2="0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Maximize / Restore Button Style -->
        <Style x:Key="TitleBarMaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="ToolTip" Value="最大化"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Path x:Name="Icon" Data="M1,1 L9,1 L9,9 L1,9 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter TargetName="Icon" Property="Data" Value="M3,1 L9,1 L9,7 M1,3 L7,3 L7,9 L1,9 Z"/>
                                <Setter Property="ToolTip" Value="元に戻す"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Close Button Style -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="ToolTip" Value="閉じる"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Path x:Name="Icon" Data="M1,1 L9,9 M9,1 L1,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TitleBarCloseButtonHoverBrush}"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TitleBarCloseButtonPressedBrush}"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Color x:Key="NeonCyanColor">#00FFFF</Color>
        <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyanColor}"/>


        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="NeonSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="{TemplateBinding MinWidth}"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TickBar x:Name="TopTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Top" Height="4" Grid.ColumnSpan="3"/>
                            <TickBar x:Name="BottomTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Bottom" Height="4" Grid.ColumnSpan="3"/>
                            <Border x:Name="TrackBackground" Background="{DynamicResource ControlBackgroundHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Margin="5,0" VerticalAlignment="Center" Height="4.0" Grid.Column="1"/>
                            <Track x:Name="PART_Track" Grid.Column="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{StaticResource NeonCyanBrush}" Opacity="0.5" BorderThickness="0" Height="4" VerticalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" BorderThickness="0" Height="4" VerticalAlignment="Center"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Background="White" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Vertical Slider Style -->
        <Style x:Key="NeonVerticalSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Left" Width="4" Grid.RowSpan="3"/>
                            <TickBar x:Name="BottomTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Right" Width="4" Grid.RowSpan="3"/>
                            <Border x:Name="TrackBackground" Background="{DynamicResource ControlBackgroundHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,5" HorizontalAlignment="Center" Width="4.0" Grid.Row="1"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0" Width="4" HorizontalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="{StaticResource NeonCyanBrush}" Opacity="0.5" BorderThickness="0" Width="4" HorizontalAlignment="Center"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Background="White" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume Slider Style (Darker Blue) -->
        <Color x:Key="NeonVolumeColor">#008B8B</Color>
        <SolidColorBrush x:Key="NeonVolumeBrush" Color="{StaticResource NeonVolumeColor}"/>

        <Style x:Key="NeonVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Left" Width="4" Grid.RowSpan="3"/>
                            <TickBar x:Name="BottomTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Right" Width="4" Grid.RowSpan="3"/>
                            <Border x:Name="TrackBackground" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,5" HorizontalAlignment="Center" Width="4.0" Grid.Row="1"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0" Width="4" HorizontalAlignment="Center"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="{StaticResource NeonVolumeBrush}" Opacity="0.5" BorderThickness="0" Width="4" HorizontalAlignment="Center"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Background="White" BorderBrush="{StaticResource NeonVolumeBrush}" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="WindowRootBorder" Style="{StaticResource MainWindowRootBorderStyle}" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Custom Title Bar -->
                <RowDefinition Height="*"/>    <!-- Row 1: Main Client Area -->
            </Grid.RowDefinitions>

            <!-- Row 0: Custom Title Bar (Height: 32) -->
            <Grid Grid.Row="0" Height="32" Background="{DynamicResource TitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Left: App Icon -->
                    <ColumnDefinition Width="*"/>    <!-- Center & Right Extension Space -->
                    <ColumnDefinition Width="Auto"/> <!-- Right: Window Control Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Left: App Icon Only -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="pack://application:,,,/Audio_Effector_icon_1.0.1.ico"
                           Width="18" Height="18"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <!-- Center: App Title (Window Centered Overlay) -->
                <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                           Text="AudioEffector"
                           Foreground="{DynamicResource TitleBarForegroundBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- Extension Space for Future Action Buttons (Between Center and Window Control Buttons) -->
                <StackPanel x:Name="TitleBarExtensionArea"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 将来の機能ボタン（検索、通知、クイックアクション等）用の配置スペース -->
                </StackPanel>

                <!-- Right: Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="TitleBarMinimizeButton"
                            Style="{StaticResource TitleBarMinimizeButtonStyle}"
                            Click="TitleBarMinimizeButton_Click"/>
                    <Button x:Name="TitleBarMaximizeButton"
                            Style="{StaticResource TitleBarMaximizeButtonStyle}"
                            Click="TitleBarMaximizeButton_Click"/>
                    <Button x:Name="TitleBarCloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="TitleBarCloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Main Client Area -->
            <Grid Grid.Row="1">
                <views:SidebarControl HorizontalAlignment="Left" Panel.ZIndex="10"/>

        <Grid Margin="50,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar -->
                <RowDefinition Height="*"/> <!-- Main Content -->
                <RowDefinition Height="Auto"/> <!-- Spectrum Analyzer -->
            </Grid.RowDefinitions>

            <!-- Top Bar (Compact Player) -->
            <Grid Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Height" Value="60"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRightPanelOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Height" From="60" To="0" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Height" From="0" To="60" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRightPanelOpen}" Value="False">
                                <Setter Property="Height" Value="60"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/> <!-- Track Info (Left) -->
                    <ColumnDefinition Width="Auto"/> <!-- Controls & Progress (Center) -->
                    <ColumnDefinition Width="1*"/> <!-- Volume & Toggle (Right) -->
                </Grid.ColumnDefinitions>

                <!-- Track Info -->
                <Grid x:Name="TopPlayerTrackInfoGrid" Grid.Column="0" Margin="10,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ControlBackgroundBrush}">
                        <Image Source="{Binding NowPlayingImage}" Stretch="UniformToFill"/>
                    </Border>
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:MarqueeTextBlock Grid.Row="0" Text="{Binding CurrentTrack.Title, FallbackValue='No Track'}" Foreground="{DynamicResource TextForegroundBrush}" FontWeight="SemiBold" FontSize="14"
                                                   IsHovered="{Binding IsMouseOver, ElementName=TopPlayerTrackInfoGrid}"/>
                        <controls:MarqueeTextBlock Grid.Row="1" Text="{Binding CurrentTrack.Artist, FallbackValue='Unknown Artist'}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="12"
                                                   IsHovered="{Binding IsMouseOver, ElementName=TopPlayerTrackInfoGrid}"/>
                    </Grid>
                </Grid>

                <!-- Controls -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <ToggleButton Command="{Binding ToggleShuffleCommand}" IsChecked="{Binding IsShuffleEnabled}" Width="24" Height="24" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" ToolTip="Shuffle">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Path Data="M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4M14.83,13.41L13.42,14.83L16.55,17.96L14.5,20H20V14.5L17.96,16.54" 
                                              Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="#606060"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        
                        <Button Command="{Binding PreviousCommand}" Width="24" Height="24" Margin="0,0,15,0">
                            <Path Data="M6,6h2v12H6V6z M9.5,12l8.5,6V6L9.5,12z" Fill="{DynamicResource TextForegroundBrush}" Stretch="Uniform"/>
                        </Button>
                        <Button Command="{Binding TogglePlayPauseCommand}" Width="32" Height="32" Background="{StaticResource NeonCyanBrush}" Foreground="White" Margin="0,0,15,0">
                            <ContentControl>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="2,0,0,0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Path Data="M14,19H18V5H14M6,19H10V5H6V19Z" Fill="White" Stretch="Uniform" Width="12" Height="14"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Button>
                        <Button Command="{Binding NextCommand}" Width="24" Height="24" Margin="0,0,15,0">
                            <Path Data="M6,18l8.5-6L6,6V18z M16,6v12h2V6H16z" Fill="{DynamicResource TextForegroundBrush}" Stretch="Uniform"/>
                        </Button>
                        <!-- Repeat Button (Top Bar) -->
                        <ToggleButton Command="{Binding ToggleRepeatCommand}" IsChecked="{Binding IsAlbumRepeat, Mode=OneWay}" Width="24" Height="24" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" ToolTip="Repeat">
                             <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Path Data="M7,7h10v3l4-4l-4-4v3H5v6h2V7z M17,17H7v-3l-4,4l4,4v-3h12v-6h-2V17z" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="#606060"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlbumRepeat}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Button Command="{Binding ShowQueueDialogCommand}" ToolTip="Play Queue" Background="Transparent" BorderThickness="0" Width="16" Height="16">
                            <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Fill="{StaticResource NeonCyanBrush}" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <Grid Width="400">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CurrentTimeDisplay}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Value="{Binding Progress, Mode=TwoWay}" Maximum="100" IsMoveToPointEnabled="True"
                                Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted" Style="{StaticResource NeonSliderStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding TotalTimeDisplay}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Volume & Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Button Command="{Binding ToggleMuteCommand}" Background="Transparent" BorderThickness="0" Width="20" Height="20" Margin="0,0,5,0">
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Path Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z" Fill="{DynamicResource TextForegroundBrush}" Stretch="Uniform"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Path Data="M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z" Fill="{DynamicResource MutedTextForegroundBrush}" Stretch="Uniform"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*">
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="MinWidth" Value="200"/>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="1*"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRightPanelOpen}" Value="False">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <controls:GridLengthAnimation Storyboard.TargetProperty="Width" From="1*" To="0*" Duration="0:0:0.6">
                                                        <controls:GridLengthAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut"/>
                                                        </controls:GridLengthAnimation.EasingFunction>
                                                    </controls:GridLengthAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <controls:GridLengthAnimation Storyboard.TargetProperty="Width" From="0*" To="1*" Duration="0:0:0.6">
                                                        <controls:GridLengthAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut"/>
                                                        </controls:GridLengthAnimation.EasingFunction>
                                                    </controls:GridLengthAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                        <Setter Property="Width" Value="0*"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>

        <!-- Left Column: Library -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentControl Grid.Row="2" Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.AllSongs}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:AllSongsView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.Albums}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:LibraryView DataContext="{Binding Library}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.Artists}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:ArtistsView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.Folders}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:FolderView DataContext="{Binding Folder}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.Favorites}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:PlaylistTracksView DataContext="{Binding Playlist}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.Playlists}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:PlaylistSelectorView DataContext="{Binding Playlist}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.PlaylistTracks}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:PlaylistTracksView DataContext="{Binding Playlist}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.Recent}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:RecentView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.Equalizer}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:EqualizerView DataContext="{Binding Equalizer}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentViewType}" Value="{x:Static vm:ViewType.DeviceSync}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:DeviceSyncView DataContext="{Binding DeviceBrowser}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            
            <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="LOADING..." Foreground="{StaticResource NeonCyanBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <!-- Simple spinner animation could be added here, using text for now -->
                </StackPanel>
            </Grid>
        </Grid>


        <!-- Separator (Vertical) and Toggle Overlay -->
        <Grid Grid.Column="1" Panel.ZIndex="10">
            <Border Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ControlBackgroundBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRightPanelOpen}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            
            <ToggleButton IsChecked="{Binding IsRightPanelOpen}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="48" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,1,1,1" ToolTip="Toggle Right Panel">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <Path x:Name="IconPath" Data="M10,6l-4,4l4,4" Stroke="{StaticResource NeonCyanBrush}" StrokeThickness="2" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="IconPath" Property="Data" Value="M6,6l4,4l-4,4"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#404040"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>

        <!-- Right Column: Player & Tab Area -->
        <Grid Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" ClipToBounds="True">
            <Grid.RowDefinitions>
                <!-- Row 0: Player Area (Maximized: 1*, Minimized: Auto) -->
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="1*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlbumViewMaximized}" Value="False">
                                    <Setter Property="Height" Value="Auto"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>

                <!-- Row 1: Bottom Extension Area (Maximized: 0*, Minimized: 1*) -->
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="0*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlbumViewMaximized}" Value="False">
                                    <Setter Property="Height" Value="1*"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>

            <!-- Top Right: Maximize / Minimize Button (Always in top-right of panel) -->
            <Button Command="{Binding ToggleAlbumViewSizeModeCommand}" 
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,15,0" Width="28" Height="28"
                    Background="Transparent" BorderThickness="0"
                    Panel.ZIndex="100">
                <Path Stretch="Uniform" Width="14" Height="14">
                    <Path.Style>
                        <Style TargetType="Path">
                            <!-- Default: Maximize (Expand) -->
                            <Setter Property="Data" Value="M5,5h5V3H3v7h2V5z M19,3h-7v2h5v5h2V3z M19,19h-5v2h7v-7h-2V19z M5,19v-5H3v7h7v-2H5z"/>
                            <Setter Property="Fill" Value="{DynamicResource MutedTextForegroundBrush}"/>
                            <Setter Property="ToolTip" Value="Maximize to Full Album View"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlbumViewMaximized}" Value="True">
                                    <!-- Minimize (Collapse) -->
                                    <Setter Property="Data" Value="M4,9h5V4H7v3H4V9z M15,4v5h5V7h-3V4H15z M17,17h3v-2h-5v5h2V17z M7,17v3h2v-5H4v2H7z"/>
                                    <Setter Property="ToolTip" Value="Minimize to Compact View"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Button>

            <!-- Row 0: Player Section -->
            <Grid Grid.Row="0">
                <!-- 1. MAXIMIZED VIEW (IsAlbumViewMaximized = True) -->
                <Grid Margin="20,42,20,15">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlbumViewMaximized}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Left: Large Cover Art, Details & Player Card Pod (Animated) -->
                        <ColumnDefinition Width="*"/>   <!-- Right: Full-Height Tracklist in Rounded Rectangle Container -->
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Album Art + Meta + Player Pod Card -->
                    <Grid Grid.Column="0" Margin="0,0,20,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Width" Value="340"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlayerControl.IsSpectrumVisible}" Value="False">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="380" Duration="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="340" Duration="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Large Album Art -->
                            <RowDefinition Height="Auto"/> <!-- Album Name & Artist & Quality -->
                            <RowDefinition Height="*"/>    <!-- Player Pod Card (Occupies remaining height) -->
                        </Grid.RowDefinitions>

                        <!-- Large Cover Art (Heavy Metallic Frame: Outer White Edge + 7px Metallic Bezel + Inner White Edge + Shadow) -->
                        <Border Grid.Row="0" CornerRadius="10" HorizontalAlignment="Center" Margin="0,6,0,30"
                                BorderBrush="{DynamicResource MetallicFrameOuterEdgeBrush}" BorderThickness="1"
                                Background="{DynamicResource MetallicCardBackgroundBrush}"
                                Padding="7"
                                Effect="{DynamicResource AlbumArtDropShadowEffect}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="260"/>
                                    <Setter Property="Height" Value="260"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayerControl.IsSpectrumVisible}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="330" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" To="330" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="260" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" To="260" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- Inner Border with Inner White Highlight Edge & Album Art Artwork -->
                            <Border CornerRadius="5" BorderBrush="{DynamicResource MetallicFrameInnerEdgeBrush}" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding NowPlayingImage}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>

                        <!-- Album Info (Font Size ~1.5x) -->
                        <StackPanel Grid.Row="1" Margin="4,4,4,12">
                            <controls:MarqueeTextBlock Text="{Binding PlaybackListName, FallbackValue='No Album Selected'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Segoe UI"/>
                            <controls:MarqueeTextBlock Text="{Binding PlaybackListSubtitle, FallbackValue=''}" FontSize="13" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,4,0,0"/>
                            
                            <!-- Quality Info (Hi-Res Text Badge without extra icons) -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentTrack.QualityLabel}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentTrack.QualityLabel}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CurrentTrack.QualityLabel}" FontSize="9" Foreground="#FFD700" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding CurrentTrack.QualityInfo}" FontSize="10" Foreground="{DynamicResource MutedTextForegroundBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Player Pod Card (Metallic Gradient Container with Top-Left Light and Bottom-Right Dark: Enlarged) -->
                        <Border Grid.Row="2" Background="{DynamicResource MetallicCardBackgroundBrush}" BorderBrush="{DynamicResource MetallicCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,16" VerticalAlignment="Top"
                                Effect="{DynamicResource CardDropShadowEffect}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Row 0: Current Track Title (Large ~1.2x: 16pt) -->
                                    <RowDefinition Height="Auto"/> <!-- Row 1: Quick Actions (Queue, Add to Playlist, Favorite - Right Aligned) -->
                                    <RowDefinition Height="Auto"/> <!-- Row 2: Playback Control Buttons (Shuffle, Prev, Big Play/Pause 48px, Next, Repeat) -->
                                    <RowDefinition Height="Auto"/> <!-- Row 3: Extended Full-Width Seekbar -->
                                    <RowDefinition Height="Auto"/> <!-- Row 4: Timestamps below seekbar (Left: CurrentTime, Right: TotalTime) -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Current Track Title (1.2x Font: 16pt, Full Width with Ellipsis) -->
                                <controls:MarqueeTextBlock Grid.Row="0" Text="{Binding CurrentTrack.Title, FallbackValue='No Track Selected'}" 
                                                           FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource NeonCyanBrush}" 
                                                           VerticalAlignment="Center" Margin="0,0,0,8"/>

                                <!-- Row 1: Quick Actions (Queue, Add to Playlist, Favorite - Right Aligned below Track Title with 1.5x spacing) -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,14">
                                    <!-- Play Queue -->
                                    <Button Command="{Binding ShowQueueDialogCommand}" Margin="0,0,10,0" ToolTip="Play Queue" Background="Transparent" BorderThickness="0" Width="18" Height="18">
                                        <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Fill="{DynamicResource MutedTextForegroundBrush}" Stretch="Uniform" Width="14" Height="14"/>
                                    </Button>
                                    <!-- Add to Playlist -->
                                    <Button Command="{Binding Playlist.ShowAddToPlaylistDialogCommand}" CommandParameter="{Binding CurrentTrack}" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip="Add to Playlist">
                                        <Path Data="M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6V13z" Fill="{DynamicResource MutedTextForegroundBrush}" Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                    <!-- Favorite -->
                                    <Button Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding CurrentTrack}" Background="Transparent" BorderThickness="0" ToolTip="Favorite">
                                        <Path Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" 
                                              Width="14" Height="14" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="#606060"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentTrack.IsFavorite}" Value="True">
                                                            <Setter Property="Fill" Value="#FF4081"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>
                                </StackPanel>

                                <!-- Row 2: Playback Controls (Shuffle, Prev, Enhanced Big Play/Pause, Next, Repeat) -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,16">
                                    <!-- Shuffle -->
                                    <ToggleButton IsChecked="{Binding IsShuffleEnabled}" Width="22" Height="22" Margin="0,0,16,0" Background="Transparent" BorderThickness="0" ToolTip="Shuffle">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Path Data="M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4M14.83,13.41L13.42,14.83L16.55,17.96L14.5,20H20V14.5L17.96,16.54" 
                                                          Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Fill" Value="#606060"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- Prev -->
                                    <Button Command="{Binding PreviousCommand}" Margin="0,0,16,0" ToolTip="Previous" Background="Transparent" BorderThickness="0">
                                        <Path Data="M6,6h2v12H6V6z M9.5,12l8.5,6V6L9.5,12z" Fill="{StaticResource NeonCyanBrush}" Width="16" Height="16" Stretch="Uniform"/>
                                    </Button>
                                    
                                    <!-- Play/Pause (Enhanced Prominent Circle Accent Button: 48x48px with Glow) -->
                                    <Button Command="{Binding TogglePlayPauseCommand}" Width="48" Height="48" Margin="0,0,16,0" ToolTip="Play/Pause" Background="Transparent" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse x:Name="PlayEllipse" Width="48" Height="48" Fill="{StaticResource NeonCyanBrush}">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#00FFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <!-- Play Icon (Centered Triangle ▶) -->
                                                    <Path x:Name="PlayIcon" Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="#0D1117" Width="16" Height="16" Stretch="Uniform" Margin="3,0,0,0"
                                                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                    <!-- Pause Icon (Centered Bars ⏸) -->
                                                    <Path x:Name="PauseIcon" Data="M6,19h4V5H6V19z M14,5v14h4V5H14z" Fill="#0D1117" Width="15" Height="16" Stretch="Uniform"
                                                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="PlayEllipse" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="PlayEllipse" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Next -->
                                    <Button Command="{Binding NextCommand}" Margin="0,0,16,0" ToolTip="Next" Background="Transparent" BorderThickness="0">
                                        <Path Data="M6,18l8.5-6L6,6V18z M16,6v12h2V6H16z" Fill="{StaticResource NeonCyanBrush}" Width="16" Height="16" Stretch="Uniform"/>
                                    </Button>

                                    <!-- Repeat -->
                                    <ToggleButton Command="{Binding ToggleRepeatCommand}" IsChecked="{Binding IsAlbumRepeat, Mode=OneWay}" Width="18" Height="18" Background="Transparent" BorderThickness="0" ToolTip="Repeat">
                                         <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Path Data="M7,7h10v3l4-4l-4-4v3H5v6h2V7z M17,17H7v-3l-4,4l4,4v-3h12v-6h-2V17z" Stretch="Uniform" Width="14" Height="14">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Fill" Value="#606060"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlbumRepeat}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </StackPanel>

                                <!-- Row 3: Extended Full-Width Seekbar -->
                                <Slider Grid.Row="3" Value="{Binding Progress, Mode=TwoWay}" Maximum="100" VerticalAlignment="Center" 
                                        IsMoveToPointEnabled="True"
                                        Thumb.DragStarted="Slider_DragStarted"
                                        Thumb.DragCompleted="Slider_DragCompleted"
                                        Style="{StaticResource NeonSliderStyle}"
                                        Margin="0,0,0,6"/>

                                <!-- Row 4: Timestamps below seekbar (Left: CurrentTime, Right: TotalTime) -->
                                <Grid Grid.Row="4">
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding CurrentTimeDisplay}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" FontFamily="Consolas"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding TotalTimeDisplay}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" FontFamily="Consolas"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right Column: Tracklist Container (Metallic Gradient Container with Top-Left Light and Bottom-Right Dark) -->
                    <Border Grid.Column="1" Background="{DynamicResource MetallicCardBackgroundBrush}" BorderBrush="{DynamicResource MetallicCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14"
                            Effect="{DynamicResource CardDropShadowEffect}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header: Playlist: <AlbumName> -->
                                <RowDefinition Height="*"/>    <!-- Scrollable Tracklist -->
                            </Grid.RowDefinitions>

                            <!-- Playlist Header (Playlist: <AlbumName> with Ellipsis & Track Count on the right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Playlist Prefix + Truncated Album Title -->
                                <TextBlock Grid.Column="0" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Run Text="Playlist: " FontWeight="SemiBold" Foreground="{StaticResource NeonCyanBrush}"/>
                                    <Run Text="{Binding PlaybackListName, FallbackValue='No Album Selected'}" FontWeight="Bold" Foreground="{DynamicResource TextForegroundBrush}"/>
                                </TextBlock>

                                <!-- Right: Track Count (e.g. "14 Tracks") -->
                                <TextBlock Grid.Column="1" Text="{Binding PlaybackListTracks.Count, StringFormat='{}{0} Tracks'}" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextForegroundBrush}" 
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,28,0"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PlaybackListTracks}" AlternationCount="999" HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RootItemBorder" 
                                                    Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                    CornerRadius="6" Margin="0,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource IndexIsOddConverter}}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ZebraOddBackgroundBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="TrackHoverBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="TrackHoverBorder" Property="Background" Value="#2200FFFF"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                    <Setter TargetName="TrackHoverBorder" Property="Background" Value="#3500FFFF"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Command="{Binding PlacementTarget.Tag.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="再生"/>
                                                            <MenuItem Header="次に再生" Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.Tag.EnqueueTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <Separator/>
                                                            <MenuItem Header="お気に入りに追加/解除" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="プレイリストに追加..." Command="{Binding PlacementTarget.Tag.Playlist.ShowAddToPlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <Separator/>
                                                            <MenuItem Header="プロパティ" Command="{Binding PlacementTarget.Tag.ShowTrackPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="ファイルの場所を開く" Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <Separator/>
                                                            <MenuItem Header="削除" Command="{Binding PlacementTarget.Tag.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/> <!-- Track Number / Playing / Paused Indicator (Inline) -->
                                                            <ColumnDefinition Width="*"/>  <!-- Track Title -->
                                                            <ColumnDefinition Width="45"/> <!-- Duration -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Track Number (Index + 1, 非再生時のみ表示: Tagから確実に取得) -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Tag, ElementName=RootItemBorder, Converter={StaticResource IndexConverter}, StringFormat='{}{0:00}.'}" 
                                                                   Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Playing Indicator (Triangle ▶, 再生中のみ表示) -->
                                                        <Path Grid.Column="0" Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{StaticResource NeonCyanBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsPlaying}" Value="True"/>
                                                                                <Condition Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>

                                                        <!-- Paused Indicator (Pause Bars ⏸, 一時停止中のみ表示) -->
                                                        <Path Grid.Column="0" Data="M6,19h4V5H6V19z M14,5v14h4V5H14z" Fill="{StaticResource NeonCyanBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsPlaying}" Value="True"/>
                                                                                <Condition Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>

                                                        <!-- Track Title -->
                                                        <controls:MarqueeTextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                                                                                   IsHovered="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}">
                                                            <controls:MarqueeTextBlock.Style>
                                                                <Style TargetType="controls:MarqueeTextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </controls:MarqueeTextBlock.Style>
                                                        </controls:MarqueeTextBlock>

                                                        <!-- Duration -->
                                                        <TextBlock Grid.Column="2" Text="{Binding DurationString}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. MINIMIZED COMPACT VIEW (IsAlbumViewMaximized = False) -->
                <Grid Margin="20,12,20,10">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlbumViewMaximized}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top: Small Cover + Track Title + Quality -->
                        <RowDefinition Height="Auto"/> <!-- Bottom: Controls + Seek -->
                    </Grid.RowDefinitions>

                    <!-- Top Info Row -->
                    <Grid x:Name="RightPanelCompactInfoGrid" Grid.Row="0" Margin="0,0,35,8" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Small Thumbnail -->
                            <ColumnDefinition Width="*"/>    <!-- Track Title & Artist & Quality -->
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="50" Height="50" CornerRadius="6" Background="{DynamicResource ControlBackgroundBrush}" ClipToBounds="True">
                            <Image Source="{Binding NowPlayingImage}" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <controls:MarqueeTextBlock Text="{Binding CurrentTrack.Title, FallbackValue='No Track Selected'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}"
                                                       IsHovered="{Binding IsMouseOver, ElementName=RightPanelCompactInfoGrid}"/>
                            <controls:MarqueeTextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Unknown Artist'}" FontSize="11" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,2,0,0"
                                                       IsHovered="{Binding IsMouseOver, ElementName=RightPanelCompactInfoGrid}"/>
                            
                            <!-- Quality Info -->
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentTrack.QualityLabel}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentTrack.QualityLabel}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CurrentTrack.QualityLabel}" FontSize="8" Foreground="#FFD700" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding CurrentTrack.QualityInfo}" FontSize="9" Foreground="{DynamicResource MutedTextForegroundBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Compact Controls & Seek Row -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Controls -->
                            <ColumnDefinition Width="*"/>    <!-- Seek -->
                            <ColumnDefinition Width="Auto"/> <!-- Add / Fav -->
                        </Grid.ColumnDefinitions>

                        <!-- Left Group: Shuffle, Prev, Play, Next, Repeat, Queue -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton IsChecked="{Binding IsShuffleEnabled}" Width="20" Height="20" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" ToolTip="Shuffle">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path Data="M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4M14.83,13.41L13.42,14.83L16.55,17.96L14.5,20H20V14.5L17.96,16.54" 
                                                  Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="#606060"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Button Command="{Binding PreviousCommand}" Margin="0,0,8,0" ToolTip="Previous" Background="Transparent" BorderThickness="0">
                                <Path Data="M6,6h2v12H6V6z M9.5,12l8.5,6V6L9.5,12z" Fill="{StaticResource NeonCyanBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            
                            <Button Command="{Binding TogglePlayPauseCommand}" Width="30" Height="30" Margin="0,0,8,0" ToolTip="Play/Pause">
                                <Grid>
                                    <Ellipse Stroke="{StaticResource NeonCyanBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="2,0,0,0"
                                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                    <Path Data="M6,19h4V5H6V19z M14,5v14h4V5H14z" Fill="White" Width="10" Height="10" Stretch="Uniform"
                                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding NextCommand}" Margin="0,0,8,0" ToolTip="Next" Background="Transparent" BorderThickness="0">
                                <Path Data="M6,18l8.5-6L6,6V18z M16,6v12h2V6H16z" Fill="{StaticResource NeonCyanBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>

                            <ToggleButton Command="{Binding ToggleRepeatCommand}" IsChecked="{Binding IsAlbumRepeat, Mode=OneWay}" Width="14" Height="14" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" ToolTip="Repeat">
                                 <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path Data="M7,7h10v3l4-4l-4-4v3H5v6h2V7z M17,17H7v-3l-4,4l4,4v-3h12v-6h-2V17z" Stretch="Uniform" Width="13" Height="13">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="#606060"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAlbumRepeat}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <Button Command="{Binding ShowQueueDialogCommand}" ToolTip="Play Queue" Background="Transparent" BorderThickness="0" Width="14" Height="14">
                                <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Fill="{StaticResource NeonCyanBrush}" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Center Group: Seek -->
                        <Grid Grid.Column="1" Margin="15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CurrentTimeDisplay}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            
                            <Slider Grid.Column="1" Value="{Binding Progress, Mode=TwoWay}" Maximum="100" VerticalAlignment="Center" 
                                    IsMoveToPointEnabled="True"
                                    Thumb.DragStarted="Slider_DragStarted"
                                    Thumb.DragCompleted="Slider_DragCompleted"
                                    Style="{StaticResource NeonSliderStyle}"/>
                                    
                            <TextBlock Grid.Column="2" Text="{Binding TotalTimeDisplay}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Right Group: Fav & Add -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding Playlist.ShowAddToPlaylistDialogCommand}" CommandParameter="{Binding CurrentTrack}" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" ToolTip="Add to Playlist">
                                <Path Data="M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6V13z" Fill="{DynamicResource MutedTextForegroundBrush}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding CurrentTrack}" Background="Transparent" BorderThickness="0" ToolTip="Favorite">
                                <Path Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" 
                                      Width="14" Height="14" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="#606060"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentTrack.IsFavorite}" Value="True">
                                                    <Setter Property="Fill" Value="#FF4081"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Row 1: Bottom Extension Area (Reserved for future widgets like Listening Stats, Smart Tags) -->
            <Grid Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}">
            </Grid>
        </Grid>
        </Grid>

        <!-- Full-Width Bottom Spectrum Analyzer Strip -->
        <Grid Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Toggle Handle Bar -->
                <RowDefinition Height="Auto"/> <!-- Animated Spectrum Panel -->
            </Grid.RowDefinitions>

            <!-- Toggle Handle Bar -->
            <Border Grid.Row="0" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Height="22">
                <Button Command="{Binding PlayerControl.ToggleSpectrumCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,2" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="ArrowIcon" Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource MutedTextForegroundBrush}" Margin="0,0,6,0"
                                          Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"/>
                                    <TextBlock Text="SPECTRUM ANALYZER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextForegroundBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding PlayerControl.IsSpectrumVisible}" Value="False">
                                    <Setter TargetName="ArrowIcon" Property="Data" Value="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- Animated Spectrum Panel (1.5x Height: 140px) -->
            <Grid Grid.Row="1" x:Name="SpectrumSlidePanel" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Height" Value="140"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlayerControl.IsSpectrumVisible}" Value="False">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Height" To="140" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Background Album Art & Dark Glow Overlay -->
                <Grid>
                    <!-- Blurred Album Art -->
                    <Image Source="{Binding SpectrumBackgroundImage}" Stretch="UniformToFill" VerticalAlignment="Center">
                        <Image.Effect>
                            <BlurEffect Radius="30"/>
                        </Image.Effect>
                    </Image>

                    <!-- Grayscale Overlay -->
                    <Image Source="{Binding SpectrumBackgroundImageGray}" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.6">
                        <Image.Effect>
                            <BlurEffect Radius="30"/>
                        </Image.Effect>
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDefaultSpectrumImage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Dark Gradient Backdrop -->
                    <Rectangle Fill="#E60A0D14" Opacity="0.88"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#40000000" Offset="0.0"/>
                                <GradientStop Color="#B8000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- Content Area: Centered Fixed Aspect Ratio Visualizer (768px Width) -->
                <Grid Width="768" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/> <!-- Frequency Indicator Header -->
                        <RowDefinition Height="*"/>  <!-- Visualizer Bars -->
                    </Grid.RowDefinitions>

                    <!-- 6-Band Frequency Indicator Labels -->
                    <UniformGrid Grid.Row="0" Columns="6" Margin="0,4,0,0" VerticalAlignment="Center"
                                 Opacity="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="60Hz" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextForegroundBrush}" HorizontalAlignment="Center" Opacity="0.75"/>
                        <TextBlock Text="250Hz" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextForegroundBrush}" HorizontalAlignment="Center" Opacity="0.75"/>
                        <TextBlock Text="500Hz" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextForegroundBrush}" HorizontalAlignment="Center" Opacity="0.75"/>
                        <TextBlock Text="1kHz" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextForegroundBrush}" HorizontalAlignment="Center" Opacity="0.75"/>
                        <TextBlock Text="4kHz" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextForegroundBrush}" HorizontalAlignment="Center" Opacity="0.75"/>
                        <TextBlock Text="16kHz" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextForegroundBrush}" HorizontalAlignment="Center" Opacity="0.75"/>
                    </UniformGrid>

                    <!-- Glowing Baseline -->
                    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,21" Background="{Binding SpectrumBorderBrush}" Opacity="0.4">
                    </Border>

                    <!-- Spectrum Bars (64 High-Density Bars with Fixed 6px Width) -->
                    <ItemsControl x:Name="SpectrumBarsControl" Grid.Row="1" ItemsSource="{Binding PlayerControl.SpectrumValues}" Margin="0,0,0,22" RenderOptions.EdgeMode="Aliased"
                                  VerticalAlignment="Bottom" Height="90" Width="768" HorizontalAlignment="Center"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="88" VerticalAlignment="Bottom">
                                    <!-- Capsule / Pill Slender Bar (Fixed 6px Width) -->
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="6"
                                            Height="{Binding Value}" MaxHeight="80" MinHeight="3" CornerRadius="3"
                                            Background="{Binding DataContext.SpectrumBarBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderBrush="{Binding DataContext.SpectrumBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderThickness="1"
                                            Opacity="{Binding Value, Converter={StaticResource ZeroToTransparent}}">
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
