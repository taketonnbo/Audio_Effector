<Window x:Class="AudioEffector.Presentation.Views.DeviceManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
        xmlns:app="clr-namespace:AudioEffector"
        xmlns:converters="clr-namespace:AudioEffector.Presentation.Converters"
        mc:Ignorable="d"
        Title="Device Storage Manager" Height="640" Width="820"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}"
        FontFamily="Segoe UI" Style="{DynamicResource CustomWindowStyle}">
    
    <Window.Resources>
        <converters:BoolToVisConverter x:Key="BoolToVis"/>
        <converters:InvertBoolConverter x:Key="InvertBool"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Installed Albums on Device" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource NeonCyanBrush}" Margin="0,0,0,16"/>

        <!-- Loading Indicator -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Scanning device..." FontSize="18" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,0,0,10"/>
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{DynamicResource NeonCyanBrush}" Background="{DynamicResource ControlBackgroundHighlightBrush}" BorderThickness="0"/>
        </StackPanel>

        <!-- Albums List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      IsEnabled="{Binding IsImporting, Converter={StaticResource InvertBool}}"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <ItemsControl ItemsSource="{Binding DeviceAlbums}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Background="Transparent" BorderThickness="0" Margin="10" Width="320">
                            <Expander.Header>
                                <Grid Width="296">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextForegroundBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Tracks.Count, StringFormat='{}{0} tracks'}" Foreground="{DynamicResource MutedTextForegroundBrush}" FontSize="10"/>
                                    </StackPanel>

                                    <!-- Import Entire Album to PC Button -->
                                    <Button Grid.Column="1" Content="⬇" ToolTip="このアルバムを PC へ取り込む（インポート）" Background="Transparent" BorderThickness="0" Margin="6,0,0,0"
                                            Command="{Binding DataContext.ImportAlbumCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DeviceManagerDialog}}}"
                                            CommandParameter="{Binding}"
                                            Width="30" Height="30" FontSize="15" Foreground="{DynamicResource NeonCyanBrush}" VerticalAlignment="Center"/>

                                    <!-- Delete Entire Album Button -->
                                    <Button Grid.Column="2" Content="🗑" ToolTip="Delete Album" Background="Transparent" BorderThickness="0" Margin="4,0,0,0" 
                                            Command="{Binding DataContext.DeleteAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="30" Height="30" FontSize="16" Foreground="#FF4040" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            
                            <ItemsControl ItemsSource="{Binding Tracks}" Margin="44,10,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource SecondaryTextForegroundBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Import Track to PC Button -->
                                            <Button Grid.Column="1" Content="⬇" ToolTip="この曲を PC へ取り込む（インポート）"
                                                    Command="{Binding DataContext.ImportTrackCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DeviceManagerDialog}}}"
                                                    CommandParameter="{Binding}"
                                                    Width="24" Height="24" Foreground="{DynamicResource NeonCyanBrush}" Background="Transparent" BorderThickness="0" Margin="4,0,2,0"/>

                                            <!-- Delete Track Button -->
                                            <Button Grid.Column="2" Content="✖" ToolTip="Delete Track"
                                                    Command="{Binding DataContext.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="24" Height="24" Foreground="#FF6060" Background="Transparent" BorderThickness="0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Reverse Transfer (Import) Progress Panel -->
        <Border x:Name="ImportProgressPanel"
                Grid.Row="2"
                Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                Margin="0,12,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ImportPhaseTextBlock"
                               Grid.Column="0"
                               Text="{Binding ImportPhaseText}"
                               Foreground="{DynamicResource NeonCyanBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="CurrentImportFileNameTextBlock"
                               Grid.Column="1"
                               Text="{Binding CurrentImportFileName}"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ImportProgressCountTextBlock"
                               Grid.Column="2"
                               Text="{Binding ImportProgressCountText}"
                               Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="ImportProgressBar"
                                 Grid.Column="0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ImportProgress, Mode=OneWay}"
                                 Height="10"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"
                                 Background="{DynamicResource ControlBackgroundHighlightBrush}"
                                 Foreground="{DynamicResource NeonCyanBrush}"
                                 BorderThickness="0"/>
                    <Button x:Name="CancelImportButton"
                            Grid.Column="1"
                            Command="{Binding CancelImportCommand}"
                            Height="28"
                            Padding="12,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource ControlBackgroundHighlightBrush}"
                            Foreground="{DynamicResource TextForegroundBrush}"
                            FontSize="11"
                            FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="✕ 取り込みを中止"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCancellingImport}" Value="True">
                                        <Setter Property="Content" Value="中止中..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Click="CloseButton_Click" Width="100" Height="30"
                    Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
