<Window x:Class="AudioEffector.Presentation.Views.TransferConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AudioEffector.Presentation.Converters"
        Title="{Binding DialogTitle}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextForegroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <converters:BoolToVisConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock"
                   Grid.Row="0"
                   Text="{Binding HeaderText}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource NeonCyanBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- 容量不足警告セクション -->
        <Border x:Name="InsufficientSpaceWarningBorder"
                Grid.Row="1"
                Visibility="{Binding IsInsufficientSpace, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="#E53E3E"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="⚠"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#E53E3E"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="接続機器の空き容量が不足しています"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="選択された楽曲の合計サイズが接続機器の空き容量を超えています。このまま転送を続行すると途中で書き込みエラーが発生する可能性があります。"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="選択曲数:" FontSize="12" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTrackCountText}" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="必要容量:" FontSize="12" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RequiredSizeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,2"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="機器の空き容量:" FontSize="12" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FreeSpaceText}" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}" Margin="0,2"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="不足容量:" FontSize="12" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="0,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ShortageSizeText}" FontSize="12" FontWeight="Bold" Foreground="#E53E3E" Margin="0,2"/>
                </Grid>

                <TextBlock x:Name="EstimatedSizeNoteTextBlock"
                           Text="※ 必要容量は変換前の元ファイルサイズ合計に基づく概算です（形式変換後はサイズが変動する場合があります）。"
                           Visibility="{Binding ShowEstimatedSizeNote, Converter={StaticResource BoolToVis}}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 形式変換確認セクション -->
        <Border x:Name="TranscodeConfirmationBorder"
                Grid.Row="2"
                Visibility="{Binding HasTranscodeTargets, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="音声フォーマット自動変換が有効です"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextForegroundBrush}"
                           Margin="0,0,0,6"/>

                <TextBlock Text="以下の対象曲は一時フォルダへ形式変換してから機器へ転送されます。変換処理のため通常より転送に時間がかかる場合があります。"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <ItemsControl x:Name="ConversionBreakdownItemsControl"
                              ItemsSource="{Binding ConversionBreakdownLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2,0,2">
                                <TextBlock Text="•" Foreground="{DynamicResource NeonCyanBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextForegroundBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- アクションボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="ProceedButton"
                    Content="{Binding PrimaryActionText}"
                    IsDefault="True"
                    Click="ProceedButton_Click"
                    Padding="14,7"
                    Margin="0,0,8,0"
                    Background="{DynamicResource NeonCyanBrush}"
                    Foreground="{DynamicResource InverseTextForegroundBrush}"
                    FontWeight="SemiBold"
                    BorderThickness="0"/>
            <Button x:Name="CancelButton"
                    Content="キャンセル"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Padding="14,7"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Foreground="{DynamicResource TextForegroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
