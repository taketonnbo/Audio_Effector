<Window x:Class="AudioEffector.Presentation.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioEffector.Presentation.Views"
        mc:Ignorable="d"
        Title="設定" Height="600" Width="800"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="設定" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource NeonCyanBrush}" Margin="0,0,0,20"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Menu -->
            <ListBox x:Name="CategoryListBox"
                     Grid.Column="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     SelectionChanged="CategoryListBox_SelectionChanged"
                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextForegroundBrush}" FontSize="16">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Margin" Value="0,0,0,5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundHighlightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Separator -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}" Width="1" HorizontalAlignment="Center" Margin="0,10"/>

            <!-- Settings Content -->
            <ScrollViewer x:Name="SettingsContentScrollViewer"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
                <Grid MinHeight="{Binding ViewportHeight, ElementName=SettingsContentScrollViewer}">
                    <!-- General Settings Panel -->
                    <StackPanel Margin="10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="一般">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="一般設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="UI テーマ" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextForegroundBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Padding="5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="起動設定" FontSize="18" FontWeight="Bold" Margin="0,20,0,10" Foreground="{DynamicResource TextForegroundBrush}"/>

                        <CheckBox Content="OS起動時に自動起動する" IsChecked="{Binding AutoStart, Mode=TwoWay}" Margin="0,0,0,10" Foreground="{DynamicResource TextForegroundBrush}" VerticalContentAlignment="Center"/>
                        <CheckBox Content="起動時に最小化状態で開始する" IsChecked="{Binding StartMinimized, Mode=TwoWay}" Margin="0,0,0,10" Foreground="{DynamicResource TextForegroundBrush}" VerticalContentAlignment="Center"/>

                        <TextBlock Text="ミニプレイヤー設定" FontSize="18" FontWeight="Bold" Margin="0,20,0,10" Foreground="{DynamicResource TextForegroundBrush}"/>

                        <TextBlock Text="最前面表示の挙動" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextForegroundBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableTopmostBehaviors}" SelectedItem="{Binding SelectedTopmostBehavior, Mode=TwoWay}" Width="250" HorizontalAlignment="Left" Padding="5" Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox Content="画面最小化時にコンパクトプレイヤーを表示しない"
                                  IsChecked="{Binding DisableMiniPlayerOnMinimize, Mode=TwoWay}"
                                  Margin="0,0,0,15"
                                  Foreground="{DynamicResource TextForegroundBrush}"
                                  VerticalContentAlignment="Center"/>

                        <TextBlock Text="ミニプレイヤーのデザイン" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextForegroundBrush}"/>
                        <ComboBox x:Name="MiniPlayerDesignStyleComboBox"
                                  ItemsSource="{Binding AvailableMiniPlayerDesignStyles}"
                                  SelectedItem="{Binding SelectedMiniPlayerDesignStyle, Mode=TwoWay}"
                                  Width="250" HorizontalAlignment="Left" Padding="5" Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox x:Name="MiniPlayerRotateAlbumArtCheckBox"
                                  Content="楽曲再生中にアルバムアートを回転させる"
                                  IsChecked="{Binding MiniPlayerRotateAlbumArt, Mode=TwoWay}"
                                  IsEnabled="{Binding IsSquareMiniPlayerDesignSelected}"
                                  Margin="0,0,0,5"
                                  Foreground="{DynamicResource TextForegroundBrush}"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Text="※「正方形（アルバムアート）」デザイン選択時に有効です。"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   Margin="20,0,0,10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Audio Devices Settings Panel -->
                    <StackPanel Margin="10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="オーディオデバイス">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="オーディオデバイス設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="サンプリングレート" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextForegroundBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableSampleRates}" SelectedItem="{Binding SelectedSampleRate, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Padding="5" Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='{}{0} Hz'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="バッファサイズ (レイテンシ)" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextForegroundBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableBufferSizes}" SelectedItem="{Binding SelectedBufferSize, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Padding="5" Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='{}{0} ms'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Effect & Playback Settings Panel -->
                    <StackPanel Margin="10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="エフェクト・再生">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="エフェクト・再生設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="再生設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextForegroundBrush}"/>

                        <TextBlock Text="基準音量 (マスター音量)" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextForegroundBrush}"/>
                        <Grid Width="300" HorizontalAlignment="Left" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding MasterVolume, Mode=TwoWay}" LargeChange="0.1" SmallChange="0.01" IsMoveToPointEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding MasterVolume, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextForegroundBrush}"/>
                        </Grid>

                        <CheckBox Content="音量を正規化する（ピーク・ノーマライズ）" IsChecked="{Binding EnableNormalize, Mode=TwoWay}" Margin="0,0,0,5" Foreground="{DynamicResource TextForegroundBrush}" VerticalContentAlignment="Center"/>
                        <TextBlock Text="※曲の再生開始時に音量スキャンを行うため、再生が始まるまでにわずかな時間（ラグ）が発生する場合があります。" FontSize="12" Foreground="{DynamicResource SecondaryTextForegroundBrush}" Margin="20,0,0,15" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Shortcuts Settings Panel -->
                    <StackPanel Margin="10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="ショートカット">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="キーボードショートカット設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <local:ShortcutInputBox Label="再生 / 一時停止" Shortcut="{Binding PlayPauseShortcut, Mode=TwoWay}"/>
                        <local:ShortcutInputBox Label="停止" Shortcut="{Binding StopShortcut, Mode=TwoWay}"/>
                        <local:ShortcutInputBox Label="次の曲へ" Shortcut="{Binding NextShortcut, Mode=TwoWay}"/>
                        <local:ShortcutInputBox Label="前の曲へ" Shortcut="{Binding PreviousShortcut, Mode=TwoWay}"/>
                        <local:ShortcutInputBox Label="ミュート切り替え" Shortcut="{Binding MuteShortcut, Mode=TwoWay}"/>
                        <local:ShortcutInputBox Label="音量を上げる" Shortcut="{Binding VolumeUpShortcut, Mode=TwoWay}"/>
                        <local:ShortcutInputBox Label="音量を下げる" Shortcut="{Binding VolumeDownShortcut, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Data Management & Other Settings Panel -->
                    <StackPanel Margin="10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="データ管理・その他">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="データ管理・その他" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="データ保存先設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextForegroundBrush}"/>

                        <TextBlock Text="データ保存先フォルダ" Margin="0,0,0,5" Foreground="{DynamicResource SecondaryTextForegroundBrush}"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DataDirectoryPathTextBox"
                                     Grid.Column="0"
                                     Text="{Binding DataDirectoryPath, Mode=OneWay}"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Padding="6,4"
                                     Margin="0,0,8,0"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     Foreground="{DynamicResource TextForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"/>
                            <Button x:Name="BrowseDataDirectoryButton"
                                    Grid.Column="1"
                                    Content="参照..."
                                    Command="{Binding BrowseDataDirectoryCommand}"
                                    Padding="12,5"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource ControlBackgroundHighlightBrush}"
                                    Foreground="{DynamicResource TextForegroundBrush}"
                                    BorderThickness="0"/>
                            <Button x:Name="ResetDataDirectoryButton"
                                    Grid.Column="2"
                                    Content="リセット"
                                    Command="{Binding ResetDataDirectoryCommand}"
                                    Padding="12,5"
                                    Background="{DynamicResource ControlBackgroundHighlightBrush}"
                                    Foreground="{DynamicResource TextForegroundBrush}"
                                    BorderThickness="0"/>
                        </Grid>
                        <TextBlock Text="※ユーザープリセット・プレイリスト・お気に入り・再生履歴・ライブラリデータ（JSON）の保存先です。アプリ設定（settings.json）は既定フォルダに保持されます。"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   Margin="0,0,0,20"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="ライブラリ・スキャン設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextForegroundBrush}"/>

                        <CheckBox Content="再スキャン時に更新されたファイルのメタデータを再読み込みする"
                                  IsChecked="{Binding DetectMetadataChangesOnRescan, Mode=TwoWay}"
                                  Margin="0,0,0,5"
                                  Foreground="{DynamicResource TextForegroundBrush}"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Text="※有効にすると、再スキャン時に既存ファイルの最終更新日時（タイムスタンプ）が変更されている場合もタグ情報を再解析してライブラリへ反映します。"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   Margin="20,0,0,20"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="機器転送設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextForegroundBrush}"/>

                        <CheckBox Content="転送時に MP4 を M4A に変換する"
                                  IsChecked="{Binding ConvertMp4ToM4a, Mode=TwoWay}"
                                  Margin="0,0,0,5"
                                  Foreground="{DynamicResource TextForegroundBrush}"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Text="※有効にすると、機器転送時に .mp4 音声ファイルを .m4a（AAC）形式へ自動変換して転送します（変換用一時ファイルは転送後に自動削除されます）。"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   Margin="20,0,0,15"
                                   TextWrapping="Wrap"/>

                        <CheckBox Content="転送時に FLAC を MP3 に変換してデータ量を削減する"
                                  IsChecked="{Binding ConvertFlacToMp3, Mode=TwoWay}"
                                  Margin="0,0,0,5"
                                  Foreground="{DynamicResource TextForegroundBrush}"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Text="※有効にすると、機器転送時に .flac 音声ファイルを .mp3（320 kbps・メタデータおよびカバーアート引継ぎ）へ自動変換して転送します（ハイレゾ音源は自動でリサンプルされます）。"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextForegroundBrush}"
                                   Margin="20,0,0,15"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Placeholder for other categories -->
                    <TextBlock Text="{Binding SelectedCategory, StringFormat='{}「{0}」の設定項目がここに入ります。'}"
                               FontSize="18" Foreground="{DynamicResource SecondaryTextForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="一般">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="オーディオデバイス">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="エフェクト・再生">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="ショートカット">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="データ管理・その他">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="閉じる" Click="CloseButton_Click" Width="100" Height="30" Background="{DynamicResource ControlBackgroundHighlightBrush}" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
