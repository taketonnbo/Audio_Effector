<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Colors -->
    <Color x:Key="WindowBackgroundColor">#F5F5F5</Color>
    <Color x:Key="PanelBackgroundColor">#EAEAEA</Color>
    <Color x:Key="ControlBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ControlBackgroundHighlightColor">#F0F0F0</Color>
    
    <Color x:Key="TextForegroundColor">#1E1E1E</Color>
    <Color x:Key="SecondaryTextForegroundColor">#404040</Color>
    <Color x:Key="MutedTextForegroundColor">#606060</Color>
    
    <Color x:Key="BorderColor">#CCCCCC</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="NeonCyanColor">#0078D7</Color>
    <Color x:Key="DarkNeonCyanColor">#005A9E</Color>

    <!-- Title Bar Colors -->
    <Color x:Key="TitleBarBackgroundColor">#F5F5F5</Color>
    <Color x:Key="TitleBarForegroundColor">#1E1E1E</Color>
    <Color x:Key="TitleBarBorderColor">#E2E8F0</Color>
    <Color x:Key="TitleBarButtonHoverColor">#E5E5E5</Color>
    <Color x:Key="TitleBarButtonPressedColor">#CCCCCC</Color>
    <Color x:Key="TitleBarCloseButtonHoverColor">#E81123</Color>
    <Color x:Key="TitleBarCloseButtonPressedColor">#C4101E</Color>

    <!-- ScrollBar Colors -->
    <Color x:Key="ScrollBarTrackColor">#00000000</Color>
    <Color x:Key="ScrollBarThumbColor">#CBD5E1</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#94A3B8</Color>
    <Color x:Key="ScrollBarThumbDraggingColor">#0078D7</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundHighlightBrush" Color="{StaticResource ControlBackgroundHighlightColor}"/>
    
    <SolidColorBrush x:Key="TextForegroundBrush" Color="{StaticResource TextForegroundColor}"/>
    <SolidColorBrush x:Key="SecondaryTextForegroundBrush" Color="{StaticResource SecondaryTextForegroundColor}"/>
    <SolidColorBrush x:Key="MutedTextForegroundBrush" Color="{StaticResource MutedTextForegroundColor}"/>
    
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    
    <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyanColor}"/>
    <SolidColorBrush x:Key="DarkNeonCyanBrush" Color="{StaticResource DarkNeonCyanColor}"/>

    <!-- Title Bar Brushes -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackgroundColor}"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="{StaticResource TitleBarForegroundColor}"/>
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="{StaticResource TitleBarBorderColor}"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="{StaticResource TitleBarButtonHoverColor}"/>
    <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="{StaticResource TitleBarButtonPressedColor}"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonHoverBrush" Color="{StaticResource TitleBarCloseButtonHoverColor}"/>
    <SolidColorBrush x:Key="TitleBarCloseButtonPressedBrush" Color="{StaticResource TitleBarCloseButtonPressedColor}"/>

    <!-- ScrollBar Brushes -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource ScrollBarTrackColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="{StaticResource ScrollBarThumbDraggingColor}"/>

    <!-- Constant Accent Colors (for Dark Surfaces like Album Art Overlay) -->
    <Color x:Key="AlwaysNeonCyanColor">#00FFFF</Color>
    <SolidColorBrush x:Key="AlwaysNeonCyanBrush" Color="{StaticResource AlwaysNeonCyanColor}"/>

    <!-- Metallic Card Background & Border Brushes (Top-Left Light, Bottom-Right Dark) -->
    <LinearGradientBrush x:Key="MetallicCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#F0F3F6" Offset="0.45"/>
        <GradientStop Color="#DFE3E8" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MetallicCardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E2E8F0" Offset="0.0"/>
        <GradientStop Color="#CBD5E1" Offset="0.5"/>
        <GradientStop Color="#94A3B8" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Zebra Stripe Brush (Subtle dynamic dark multiply for Light Theme) -->
    <SolidColorBrush x:Key="ZebraOddBackgroundBrush" Color="#0C000000"/>

    <!-- Metallic Frame Edge Highlight Brushes -->
    <SolidColorBrush x:Key="MetallicFrameOuterEdgeBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MetallicFrameInnerEdgeBrush" Color="#FFFFFF"/>

    <!-- Dynamic Theme Drop Shadows (Light Theme: Soft, subtle opacity) -->
    <DropShadowEffect x:Key="CardDropShadowEffect" Color="#000000" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.30"/>
    <DropShadowEffect x:Key="AlbumArtDropShadowEffect" Color="#000000" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.35"/>

</ResourceDictionary>
