<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- テストデータ配列リテラルやテスト内カルチャ指定の軽微なアナライザ警告を抑制（MCPサーバ詳細設計書 2.2 準拠） -->
    <NoWarn>$(NoWarn);CA1304;CA1311;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioEffector\AudioEffector.csproj" />
    <ProjectReference Include="..\AudioEffector.Domain\AudioEffector.Domain.csproj" />
    <ProjectReference Include="..\AudioEffector.Application\AudioEffector.Application.csproj" />
    <ProjectReference Include="..\AudioEffector.Infrastructure\AudioEffector.Infrastructure.csproj" />
    <ProjectReference Include="..\AudioEffector.McpServer\AudioEffector.McpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\AudioEffector\Audio_Effector_icon_1.0.1.ico" Link="Audio_Effector_icon_1.0.1.ico" />
  </ItemGroup>

</Project>
